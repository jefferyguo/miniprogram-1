+function getDateRange(dateStr, timezone = 'Asia/Shanghai') {
+  const fmt = String(dateStr || '').trim()
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(fmt)) throw new Error('日期格式必须为 YYYY-MM-DD')
+  // 使用 UTC+8 构建范围
+  const start = new Date(`${fmt}T00:00:00+08:00`)
+  const end = new Date(`${fmt}T00:00:00+08:00`)
+  end.setDate(end.getDate() + 1)
+  return {
+    startAt: `${fmt} 00:00:00`,
+    endAt: `${end.getFullYear()}-${String(end.getMonth() + 1).padStart(2, '0')}-${String(end.getDate()).padStart(2, '0')} 00:00:00`,
+    startTimestamp: start.getTime(),
+    endTimestamp: end.getTime()
+  }
+}
+
+function getWeekRange(weekStartStr, timezone = 'Asia/Shanghai') {
+  const fmt = String(weekStartStr || '').trim()
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(fmt)) throw new Error('周开始日期必须为 YYYY-MM-DD')
+  const start = new Date(`${fmt}T00:00:00+08:00`)
+  const end = new Date(start.getTime())
+  end.setDate(end.getDate() + 7)
+  const prevStart = new Date(start.getTime())
+  prevStart.setDate(prevStart.getDate() - 7)
+  return {
+    startAt: `${fmt} 00:00:00`,
+    endAt: `${end.getFullYear()}-${String(end.getMonth() + 1).padStart(2, '0')}-${String(end.getDate()).padStart(2, '0')} 00:00:00`,
+    prevStartAt: `${prevStart.getFullYear()}-${String(prevStart.getMonth() + 1).padStart(2, '0')}-${String(prevStart.getDate()).padStart(2, '0')} 00:00:00`
+  }
+}
+
+function getISOWeekNumber(dateStr) {
+  const d = new Date(`${dateStr}T12:00:00+08:00`)
+  const dayNum = d.getUTCDay() || 7
+  d.setUTCDate(d.getUTCDate() + 4 - dayNum)
+  const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1))
+  const weekNo = Math.ceil(((d - yearStart) / 86400000 + 1) / 7)
+  return `W${String(weekNo).padStart(2, '0')}`
+}
+
+function buildRegistrationReport(users, rangeLabel) {
+  const total = users.length
+  const phoneAuthorized = users.filter(u => u.phoneBound === true).length
+  const phoneUnauthorized = total - phoneAuthorized
+  const bySource = { wechat: 0, custom: 0, random: 0 }
+  users.forEach(u => {
+    const src = String(u.nicknameSource || '').trim()
+    if (src === 'wechat') bySource.wechat++
+    else if (src === 'custom') bySource.custom++
+    else bySource.random++
+  })
+  return {
+    rangeLabel,
+    total,
+    phoneAuthorized,
+    phoneUnauthorized,
+    phoneAuthorizationRate: total > 0 ? Math.round((phoneAuthorized / total) * 1000) / 10 : 0,
+    byNicknameSource: bySource
+  }
+}
+
+async function adminGetDailyRegistrationReport(event, wxContext) {
+  const admin = await requireAdmin(wxContext.OPENID, ['super_admin', 'admin'])
+  if (!admin.ok) return fail(admin.code, admin.message)
+
+  const date = String(event.date || '').trim()
+  if (!date) return fail('INVALID_DATE', '日期不能为空')
+  // 完整手机号仅 super_admin 可查看
+  const showFullPhone = event.showFullPhone === true && admin.profile.role === 'super_admin'
+
+  try {
+    const range = getDateRange(date)
+    // 使用 count 获取准确总数，再用分页查询获取用户列表
+    const countResult = await db.collection(COLLECTIONS.users)
+      .where({ registeredAt: _.gte(range.startAt).and(_.lt(range.endAt)) })
+      .count()
+    const totalCount = countResult.total || 0
+
+    const result = await db.collection(COLLECTIONS.users)
+      .where({
+        registeredAt: _.gte(range.startAt).and(_.lt(range.endAt))
+      })
+      .field({
+        _id: true, openid: true, nickname: true, nicknameSource: true,
+        phone: showFullPhone, phoneMasked: true, phoneBound: true,
+        registeredAt: true, profileCompleted: true, createdAt: true
+      })
+      .limit(500)
+      .get()
+
+    const users = (result.data || []).map(u => ({
+      userId: String(u._id || '').slice(-8),
+      nickname: u.nickname || '',
+      nicknameSource: u.nicknameSource || 'default',
+      phoneMasked: u.phoneMasked || '',
+      phone: showFullPhone ? (u.phone || '') : '',
+      hasPhone: u.phoneBound === true,
+      registeredAt: u.registeredAt || u.createdAt || '',
+      profileCompleted: u.profileCompleted === true
+    }))
+
+    // 使用 count() 结果覆盖 users.length，避免 limit(500) 截断导致统计偏低
+    const report = buildRegistrationReport(users, date)
+    report.total = totalCount
+    report.count = totalCount
+    report.phoneAuthorized = users.filter(u => u.hasPhone).length
+    report.phoneUnauthorized = totalCount - report.phoneAuthorized
+
+    return success({
+      date,
+      total: totalCount,
+      count: totalCount,
+      phoneAuthorized: report.phoneAuthorized,
+      phoneUnauthorized: report.phoneUnauthorized,
+      phoneAuthorizationRate: totalCount > 0 ? Math.round((report.phoneAuthorized / totalCount) * 1000) / 10 : 0,
+      byNicknameSource: report.byNicknameSource,
+      users,
+      profile: admin.profile
+    })
+  } catch (error) {
+    console.error('[adminGetDailyRegistrationReport] error:', error && error.message)
+    return fail('REPORT_QUERY_FAILED', '注册报表查询失败')
+  }
+}
+
+async function adminGetWeeklyRegistrationReport(event, wxContext) {
+  const admin = await requireAdmin(wxContext.OPENID, ['super_admin', 'admin'])
+  if (!admin.ok) return fail(admin.code, admin.message)
+
+  const weekStart = String(event.weekStart || '').trim()
