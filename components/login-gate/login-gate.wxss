.gate-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9990;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: gateFadeIn 0.2s ease-out;
}
@keyframes gateFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.gate-panel {
  position: relative;
  width: 600rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
  overflow-y: auto;
  animation: gateSlideUp 0.25s ease-out;
}

.gate-close {
  position: absolute;
  top: 22rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f3f5f8;
  color: #8a92a3;
  font-size: 36rpx;
  line-height: 56rpx;
  text-align: center;
  z-index: 2;
}
@keyframes gateSlideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.gate-head {
  text-align: center;
  margin-bottom: 36rpx;
}
.gate-brand {
  display: block;
  color: #07a955;
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.gate-title {
  display: block;
  font-size: var(--font-ui-36, 36rpx);
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}
.gate-desc {
  display: block;
  font-size: var(--font-reading-26, 26rpx);
  color: #8a8f99;
  line-height: 1.6;
}

/* 按钮组 */
.gate-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.gate-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: var(--font-ui-30, 30rpx);
  font-weight: 600;
  border: none;
  padding: 0;
}
.gate-btn::after { border: none; }
.gate-btn-primary {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
}
.gate-btn-outline {
  background: #f0faf4;
  color: #07c160;
}
.gate-btn-ghost {
  background: transparent;
  color: #8a8f99;
  font-weight: 400;
  font-size: var(--font-ui-28, 28rpx);
}
.gate-btn-icon {
  font-size: 32rpx;
}
.btn-disabled {
  opacity: 0.6;
}
.gate-btn-disabled {
  background: #c0c4cc;
  color: #fff;
}

/* 协议勾选 */
.gate-agreement {
  margin-bottom: 24rpx;
}
.agreement-check-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 0 4rpx;
}
.agree-checkbox {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  border: 3rpx solid #c8ccd4;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  transition: all 0.15s ease;
}
.agree-checkbox.checked {
  background: #07c160;
  border-color: #07c160;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}
.agreement-text {
  font-size: var(--font-reading-26, 26rpx);
  color: #666;
  line-height: 1.6;
  flex: 1;
}
.agreement-link {
  color: #07c160;
  font-weight: 500;
}

.gate-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding-top: 16rpx;
}
.gate-link {
  font-size: var(--font-ui-26, 26rpx);
  color: #8a8f99;
}
.gate-link.center {
  display: block;
  text-align: center;
}
.gate-divider {
  color: #dde1e6;
  font-size: 24rpx;
}

/* 用户名区域 */
.username-section {
  margin-bottom: 28rpx;
}
.username-label {
  display: block;
  font-size: var(--font-ui-28, 28rpx);
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}
.username-input {
  width: 100%;
  height: 80rpx;
  background: #f5f7fb;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: var(--font-ui-30, 30rpx);
  box-sizing: border-box;
  border: 2rpx solid transparent;
}
.username-input:focus {
  border-color: #07c160;
  background: #fff;
}
.input-error {
  border-color: #e74c3c;
}
.username-hint {
  display: block;
  font-size: var(--font-ui-24, 24rpx);
  color: #b0b5bf;
  margin-top: 8rpx;
}
.username-error {
  display: block;
  font-size: var(--font-ui-24, 24rpx);
  color: #e74c3c;
  margin-top: 8rpx;
}

/* 随机用户名展示 */
.random-name-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f7fb;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}
.random-name-text {
  font-size: var(--font-ui-32, 32rpx);
  font-weight: 600;
  color: #1a1a2e;
}
.random-name-refresh {
  font-size: var(--font-ui-26, 26rpx);
  color: #07c160;
  padding: 8rpx 16rpx;
}

/* 手机号 */
.phone-tip {
  display: block;
  text-align: center;
  font-size: var(--font-reading-24, 24rpx);
  color: #b0b5bf;
  margin-top: 16rpx;
  line-height: 1.5;
}
.gate-back {
  text-align: center;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #8a8f99;
}
