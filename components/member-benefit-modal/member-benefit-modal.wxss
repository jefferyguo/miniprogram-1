.member-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 10vh 24rpx 0;
  box-sizing: border-box;
  background: rgba(18, 27, 44, 0.52);
}

.member-panel {
  width: 100%;
  height: 68vh;
  min-height: 62vh;
  max-height: 72vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border: 1rpx solid rgba(238, 240, 244, 0.9);
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 80rpx rgba(20, 31, 52, 0.2);
}

.member-header {
  min-height: 98rpx;
  padding: 20rpx 28rpx 16rpx;
  display: flex;
  flex-shrink: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
}

.member-heading {
  flex: 1;
  min-width: 0;
}

.member-title,
.member-subtitle,
.purchase-title,
.payment-status,
.payment-tip {
  display: block;
}

.member-title {
  color: #24324f;
  font-size: var(--font-ui-34, 34rpx);
  line-height: 1.25;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.member-subtitle {
  margin-top: 4rpx;
  color: #6b7280;
  font-size: var(--font-ui-24, 24rpx);
  line-height: 1.35;
}

.member-close {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7d8593;
  background: #f7f8fa;
  font-size: 29rpx;
  line-height: 1;
}

.member-content {
  width: 100%;
  min-height: 0;
  flex: 1;
  padding: 12rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  box-sizing: border-box;
}

.purchase-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.limit-content {
  padding-top: 30rpx;
}

.usage-pill {
  display: inline-flex;
  padding: 7rpx 16rpx;
  border: 1rpx solid #ead8ba;
  border-radius: 999rpx;
  color: #9a6d2e;
  background: #fff8ec;
  font-size: var(--font-ui-22, 22rpx);
  font-weight: 700;
}

.limit-desc {
  display: block;
  margin: 18rpx 0 24rpx;
  color: #6b7280;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.5;
}

.benefit-compare {
  display: flex;
  gap: 12rpx;
}

.benefit-column {
  flex: 1;
  min-width: 0;
  padding: 16rpx 17rpx;
  border: 1rpx solid #eef0f4;
  border-radius: 19rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.member-column {
  border-color: #ead8b8;
  background: #fff8ec;
}

.benefit-column-title {
  display: block;
  margin-bottom: 10rpx;
  color: #4b5563;
  font-size: var(--font-ui-24, 24rpx);
  line-height: 1.3;
  font-weight: 800;
}

.member-column-title {
  color: #9a6a25;
}

.benefit-row {
  display: flex;
  align-items: center;
  gap: 7rpx;
  margin-top: 7rpx;
}

.benefit-dot {
  width: 20rpx;
  flex-shrink: 0;
  color: #9aa1ac;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 800;
}

.member-dot {
  color: #b9822e;
  font-size: 18rpx;
}

.benefit-label {
  min-width: 0;
  color: #5f6878;
  font-size: var(--font-ui-22, 22rpx);
  line-height: 1.35;
}

.purchase-list {
  margin-top: 22rpx;
}

.purchase-card {
  position: relative;
  height: 134rpx;
  margin-bottom: 13rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  overflow: hidden;
  border: 1rpx solid #eef0f4;
  border-radius: 21rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.yearly-card {
  border-color: #d8a24a;
  background: #fff8ec;
  box-shadow: 0 8rpx 24rpx rgba(185, 130, 46, 0.08);
}

.purchase-title {
  width: 122rpx;
  flex-shrink: 0;
  color: #24324f;
  font-size: var(--font-ui-27, 27rpx);
  line-height: 1.35;
  font-weight: 800;
}

.purchase-action {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
}

.recommend-badge {
  position: absolute;
  top: 8rpx;
  right: 16rpx;
  z-index: 1;
  padding: 5rpx 13rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #b9822e;
  font-size: 18rpx;
  line-height: 1.1;
  font-weight: 700;
}

.purchase-price-wrap {
  flex-shrink: 0;
  white-space: nowrap;
}

.purchase-price {
  color: #b9822e;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 800;
}

.purchase-unit {
  margin-left: 3rpx;
  color: #8a93a3;
  font-size: 23rpx;
}

.member-primary,
.member-pay-btn {
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: var(--font-ui-25, 25rpx);
  font-weight: 700;
  box-sizing: border-box;
}

.member-primary {
  width: 100%;
  height: 68rpx;
  line-height: 68rpx;
  color: #ffffff;
  background: #24324f;
}

.member-pay-btn {
  width: 168rpx;
  height: 62rpx;
  line-height: 62rpx;
  flex-shrink: 0;
  color: #24324f;
  background: #f7f8fa;
  border: 1rpx solid #dfe3ea;
}

.member-pay-btn.yearly {
  color: #ffffff;
  background: #24324f;
  border-color: #24324f;
}

.member-primary::after,
.member-pay-btn::after {
  border: none;
}

.member-pay-btn[disabled] {
  color: #9aa0aa;
  background: #eef0f3;
  border-color: #e5e7eb;
  opacity: 0.82;
}

.payment-status {
  margin-top: 2rpx;
  color: #5f6878;
  text-align: center;
  font-size: var(--font-ui-21, 21rpx);
  line-height: 1.35;
}

.payment-tip {
  margin-top: 6rpx;
  color: #8a93a3;
  text-align: center;
  font-size: var(--font-reading-22, 22rpx);
  line-height: 1.35;
}
