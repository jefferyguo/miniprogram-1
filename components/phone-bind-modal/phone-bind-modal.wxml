<view wx:if="{{visible}}" class="phone-mask" bindtap="skip">
  <view class="phone-panel" catchtap="noop">
    <view class="phone-head">
      <view>
        <text class="phone-title">请先登录</text>
        <text class="phone-subtitle">{{message}}</text>
      </view>
      <view class="phone-close" bindtap="skip">×</view>
    </view>

    <button
      class="phone-primary"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumberLogin"
      loading="{{binding}}"
      disabled="{{binding}}"
    >
      登录
    </button>
    <button class="phone-secondary" disabled="{{binding}}" bindtap="skip">暂不登录</button>
  </view>
</view>
