page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card {
  border-radius: 36rpx;
  padding: 44rpx 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #27364a 0%, #3a4a63 100%);
  box-shadow: 0 16rpx 40rpx rgba(39, 54, 74, 0.16);
}

.hero-title {
  display: block;
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 14rpx;
}

.hero-desc {
  display: block;
  color: rgba(255, 255, 255, 0.78);
  font-size: 27rpx;
  line-height: 1.55;
}

.benefit-card {
  margin-top: 30rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 24rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  min-height: 58rpx;
}

.benefit-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5568d9;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.benefit-text {
  color: #24315f;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 700;
}

.login-btn {
  height: 84rpx;
  line-height: 84rpx;
  margin: 40rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #5568d9;
  font-size: 28rpx;
  font-weight: 900;
}

.disabled-btn {
  opacity: 0.7;
}

.login-tip {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 24rpx;
  line-height: 1.5;
}
