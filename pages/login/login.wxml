<page-meta page-style="{{fontSizePageStyle}}"></page-meta>
<view class="page">
  <view class="hero-card">
    <text class="hero-title">登录杨勤口才训练KEEP</text>
    <text class="hero-desc">绑定手机号后可保存训练记录、生成 AI 点评，并自动匹配会员权益。</text>
  </view>

  <view class="benefit-card">
    <text class="section-title">登录后你可以</text>
    <view class="benefit-item">
      <text class="benefit-dot"></text>
      <text class="benefit-text">保存录音、录像和训练记录</text>
    </view>
    <view class="benefit-item">
      <text class="benefit-dot"></text>
      <text class="benefit-text">生成 AI 点评与表达力测评</text>
    </view>
    <view class="benefit-item">
      <text class="benefit-dot"></text>
      <text class="benefit-text">自动匹配月度、年度或管理员权益</text>
    </view>
  </view>

  <button
    class="login-btn {{bindingLogin ? 'disabled-btn' : ''}}"
    bindtap="openLoginGate"
    loading="{{bindingLogin}}"
    disabled="{{bindingLogin}}"
  >手机号快捷登录</button>

  <text class="login-tip">手机号仅用于身份和会员权益识别，不会在广场公开展示。</text>
  <button class="skip-btn" bindtap="skipLogin">暂不登录</button>
</view>
