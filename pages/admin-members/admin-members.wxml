<view class="page">
  <view class="page-head">
    <view>
      <text class="page-title">会员/权限管理</text>
      <text class="page-desc">按手机号管理学员身份和有效期</text>
    </view>
    <button wx:if="{{isAdmin}}" class="add-btn" bindtap="openCreateEditor">添加学员</button>
  </view>

  <view wx:if="{{isAdmin}}" class="search-card">
    <view class="search-row">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="请输入姓名或手机号"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="searchMembers"
      />
      <button class="search-btn" loading="{{loadingList}}" bindtap="searchMembers">搜索</button>
    </view>
    <button wx:if="{{keyword}}" class="clear-btn" bindtap="clearSearch">清除搜索条件</button>
  </view>

  <view wx:if="{{isAdmin}}" class="member-list">
    <view
      class="member-card"
      wx:for="{{phoneEntitlements}}"
      wx:key="phone"
      data-id="{{item.id}}"
      data-phone="{{item.phone}}"
      bindtap="openEditEditor"
    >
      <view class="member-head">
        <view class="member-name-wrap">
          <text class="member-name">{{item.name}}</text>
          <text wx:if="{{item.isLegacy}}" class="legacy-tag">旧数据</text>
        </view>
        <text class="status-tag {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <text class="member-phone">{{item.phoneMask}}</text>
      <view class="member-meta">
        <view class="meta-item"><text class="meta-label">身份类型</text><text class="meta-value">{{item.membershipName}}</text></view>
        <view class="meta-item"><text class="meta-label">有效期</text><text class="meta-value">{{item.expireText}}</text></view>
        <view class="meta-item meta-wide"><text class="meta-label">班级</text><text class="meta-value">{{item.className || '未填写班级'}}</text></view>
      </view>
      <view class="card-enter"><text>查看并编辑</text><text class="arrow">›</text></view>
    </view>

    <view wx:if="{{loadingList}}" class="state-card">正在读取学员列表...</view>
    <view wx:elif="{{phoneEntitlements.length === 0}}" class="state-card">
      <text class="state-title">暂无学员档案</text>
      <text class="state-desc">点击右上角“添加学员”建立第一条档案</text>
    </view>
  </view>

  <view wx:elif="{{!checkingAdmin}}" class="state-card no-admin-card">
    <text class="state-title">暂无管理员权限</text>
    <text class="state-desc">请使用管理员账号进入此页面</text>
  </view>
</view>

<view wx:if="{{showEditor}}" class="editor-mask" bindtap="closeEditor">
  <view class="editor-panel" catchtap="noop">
    <view class="editor-head">
      <text class="editor-title">{{editorTitle}}</text>
      <view class="editor-close" bindtap="closeEditor">×</view>
    </view>

    <scroll-view class="editor-scroll" scroll-y>
      <view class="form-field">
        <text class="form-label">姓名</text>
        <input class="form-input" value="{{form.name}}" placeholder="请输入姓名" data-field="name" bindinput="onFormInput" />
      </view>
      <view class="form-field">
        <text class="form-label">手机号</text>
        <input class="form-input {{isEditing ? 'form-input-disabled' : ''}}" type="number" maxlength="11" disabled="{{isEditing}}" value="{{form.phone}}" placeholder="请输入手机号" data-field="phone" bindinput="onFormInput" />
      </view>
      <view class="form-field">
        <text class="form-label">班级</text>
        <input class="form-input" value="{{form.className}}" placeholder="例如：成人口才一期班" data-field="className" bindinput="onFormInput" />
      </view>
      <view class="form-field">
        <text class="form-label">备注</text>
        <textarea class="form-textarea" value="{{form.remark}}" placeholder="选填" data-field="remark" bindinput="onFormInput"></textarea>
      </view>
      <view class="form-field">
        <text class="form-label">身份类型</text>
        <picker mode="selector" range="{{membershipOptions}}" range-key="name" value="{{membershipIndex}}" bindchange="onMembershipChange">
          <view class="picker-box"><text>{{selectedMembershipName}}</text><text class="picker-arrow">›</text></view>
        </picker>
      </view>
      <view wx:if="{{showExpiryPicker}}" class="form-field">
        <text class="form-label">到期日期</text>
        <picker mode="date" value="{{form.membershipEndAt}}" bindchange="onEndDateChange">
          <view class="picker-box"><text>{{form.membershipEndAt || '请选择到期日期'}}</text><text class="picker-arrow">›</text></view>
        </picker>
        <text class="form-tip">月度默认 30 天，年度默认 365 天，可手动修改</text>
      </view>
      <view wx:else class="validity-hint">{{form.membershipType === 'admin' ? '管理员长期有效，AI 次数不限' : '普通用户无会员到期日期'}}</view>

      <view wx:if="{{isEditing && !currentIsLegacy}}" class="manage-actions">
        <button class="manage-btn toggle-btn" bindtap="toggleCurrentMember">{{currentIsDisabled ? '启用学员' : '停用学员'}}</button>
        <button class="manage-btn delete-btn" bindtap="deleteCurrentMember">删除档案</button>
      </view>
    </scroll-view>

    <view class="editor-actions">
      <button class="cancel-btn" disabled="{{saving}}" bindtap="closeEditor">取消</button>
      <button class="save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="saveMember">保存</button>
    </view>
  </view>
</view>
