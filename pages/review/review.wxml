<page-meta page-style="{{fontSizePageStyle}}{{showAiFeedbackPanel ? 'overflow: hidden;' : ''}}"></page-meta>

<view class="page">
  <view class="hero-card">
    <text class="hero-title">点评中心</text>
    <text class="hero-desc">查看训练作品和 AI 点评状态</text>
  </view>

  <view class="overview-row">
    <view class="overview-card">
      <text class="overview-value">{{pendingCount}}</text>
      <text class="overview-label">待生成AI</text>
    </view>
    <view class="overview-card">
      <text class="overview-value blue-value">{{reviewedCount}}</text>
      <text class="overview-label">已生成AI</text>
    </view>
    <view class="overview-card">
      <text class="overview-value purple-value">{{totalCount}}</text>
      <text class="overview-label">已保存作品</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">我的训练反馈</text>
    <view
      class="feedback-card"
      wx:for="{{feedbackCards}}"
      wx:key="title"
      data-type="{{item.type}}"
      bindtap="handleFeedbackCardTap"
      hover-class="card-hover"
    >
      <view class="feedback-main">
        <text class="feedback-title">{{item.title}}</text>
        <text class="feedback-desc">{{item.desc}}</text>
      </view>
      <text class="feedback-arrow">›</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title no-margin">作品列表</text>
        <text wx:if="{{filterType !== 'all'}}" class="filter-text">当前查看：{{filterTitle || filterText}}</text>
      </view>
      <button wx:if="{{filterType !== 'all'}}" class="clear-filter-btn" bindtap="clearFilter">查看全部</button>
      <text wx:else class="section-count">共 {{totalCount}} 个</text>
    </view>

    <view wx:if="{{filteredWorks.length > 0}}" class="work-list">
      <view class="work-card" wx:for="{{filteredWorks}}" wx:key="key">
        <view class="work-top">
          <text class="work-type">{{item.displayType}}</text>
          <text class="status-tag {{item.savedStatusClass}}">{{item.savedStatusText}}</text>
        </view>

        <view class="work-body">
          <text class="work-title">{{item.displayTitle}}</text>
          <text class="work-subtitle">{{item.displaySubtitle}}</text>
        </view>

        <view class="work-meta">
          <text>时长：{{item.displayDuration}}</text>
          <text>保存时间：{{item.displayCreatedAt}}</text>
        </view>

        <view class="status-row">
          <text class="state-pill {{item.aiStatusClass}}">{{item.aiStatusText}}</text>
        </view>

        <text wx:if="{{item.isPublic}}" class="public-status">已发布到广场</text>
        <text wx:if="{{item.aiTip}}" class="ai-tip">{{item.aiTip}}</text>

        <view class="audio-player" wx:if="{{item.workType === 'audio' && audioPlayer.activeKey === item.audioKey}}">
          <view class="audio-time-row">
            <text>{{audioPlayer.currentText}}</text>
            <text>{{audioPlayer.durationText}}</text>
          </view>
          <slider
            class="audio-slider"
            min="0"
            max="100"
            step="1"
            value="{{audioPlayer.progress}}"
            activeColor="#3478f6"
            backgroundColor="#dfe6f2"
            block-size="14"
            bindchange="onAudioSliderChange"
          />
        </view>

        <view class="work-actions">
          <view class="work-action-row primary-row">
            <button
              class="work-action-btn play-btn"
              data-key="{{item.key}}"
              bindtap="playWork"
            >
              <block wx:if="{{item.workType === 'audio' && audioPlayer.activeKey === item.audioKey && audioPlayer.isPlaying}}">暂停</block>
              <block wx:elif="{{item.workType === 'audio' && audioPlayer.activeKey === item.audioKey && audioPlayer.isPaused}}">继续</block>
              <block wx:else>{{item.displayActionText}}</block>
            </button>
            <button
              class="work-action-btn feedback-btn {{item.feedbackActionClass}}"
              data-key="{{item.key}}"
              disabled="{{item.feedbackActionDisabled}}"
              bindtap="handleFeedbackAction"
            >{{item.feedbackActionText}}</button>
          </view>

          <view class="work-action-row secondary-row">
            <button
              wx:if="{{item.shareAllowed && item.isPublic}}"
              class="work-action-btn share-btn"
              open-type="share"
              data-work-id="{{item.squareWorkId || item.cloudId || item.shareId}}"
              data-square-work-id="{{item.squareWorkId || item.cloudId || item.shareId}}"
              data-work-index="{{index}}"
              data-title="{{item.title || item.taskTitle || item.displaySubtitle}}"
              data-thumb="{{item.thumbTempFilePath || item.coverUrl || item.poster || ''}}"
            >分享</button>
            <button
              wx:if="{{item.shareAllowed && !item.isPublic}}"
              class="work-action-btn share-btn"
              bindtap="showPrivateShareTip"
            >分享</button>
            <button
              wx:if="{{item.shareAllowed && !item.isPublic}}"
              class="work-action-btn public-btn"
              data-key="{{item.key}}"
              bindtap="publishWork"
            >发布广场</button>
            <button
              wx:if="{{item.isPublic}}"
              class="work-action-btn unpublic-btn"
              data-key="{{item.key}}"
              bindtap="unpublishWork"
            >取消公开</button>
            <button class="work-action-btn delete-btn" data-key="{{item.key}}" bindtap="deleteWork">删除</button>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-card" wx:else>
      <text class="empty-title">{{emptyTitle}}</text>
      <text class="empty-desc">{{emptyDesc}}</text>
      <button class="empty-btn" bindtap="switchToTraining">{{emptyButtonText}}</button>
    </view>
  </view>
</view>
<member-benefit-modal id="memberBenefitModal" />

<view class="ai-feedback-mask" wx:if="{{showAiFeedbackPanel}}" bindtap="closeAiFeedbackPanel">
  <view class="ai-feedback-panel" catchtap="noop">
    <view class="ai-feedback-header">
      <text class="ai-feedback-title">{{currentAiFeedback.title || 'AI点评'}}</text>
      <text class="ai-feedback-close" bindtap="closeAiFeedbackPanel">×</text>
    </view>

    <scroll-view
      class="ai-feedback-scroll"
      scroll-y="{{true}}"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      scroll-top="{{aiFeedbackScrollTop}}"
    >
      <view class="ai-feedback-content">
      <view class="ai-generated-notice">AI生成内容，仅供表达训练参考</view>
      <view class="ai-mode-notice {{currentAiFeedback.noticeClass}}" wx:if="{{currentAiFeedback.noticeText}}">
        {{currentAiFeedback.noticeText}}
      </view>

      <view class="ai-section" wx:if="{{currentAiFeedback.summary}}">
        <view class="ai-section-title">综合评价</view>
        <view class="ai-section-text">{{currentAiFeedback.summary}}</view>
      </view>
      <ability-radar wx:if="{{currentAiFeedback.abilityRadar}}" radar="{{currentAiFeedback.abilityRadar}}"></ability-radar>
      <view class="ai-section" wx:if="{{currentAiFeedback.basis}}">
        <view class="ai-section-title">点评依据</view>
        <view class="ai-section-text">{{currentAiFeedback.basis}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.dimensionScores.length}}">
        <view class="ai-section-title">维度评分</view>
        <view class="ai-dimension-item" wx:for="{{currentAiFeedback.dimensionScores}}" wx:key="name">
          <view class="ai-dimension-row">
            <text class="ai-dimension-name">{{item.name}}</text>
            <text class="ai-dimension-score">{{item.score}}分</text>
          </view>
          <view class="ai-section-text">{{item.comment}}</view>
        </view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.contentReview}}">
        <view class="ai-section-title">内容表现</view>
        <view class="ai-section-text">{{currentAiFeedback.contentReview}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.voiceStateReview}}">
        <view class="ai-section-title">声音状态</view>
        <view class="ai-section-text">{{currentAiFeedback.voiceStateReview}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.strengths.length}}">
        <view class="ai-section-title">可以保留的做法</view>
        <view wx:for="{{currentAiFeedback.strengths}}" wx:key="*this" class="ai-list-item">{{index + 1}}. {{item}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.improvements.length}}">
        <view class="ai-section-title">下次提升重点</view>
        <view wx:for="{{currentAiFeedback.improvements}}" wx:key="*this" class="ai-list-item">{{index + 1}}. {{item}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.nextPractice.length}}">
        <view class="ai-section-title">下一次训练动作</view>
        <view wx:for="{{currentAiFeedback.nextPractice}}" wx:key="*this" class="ai-list-item">{{index + 1}}. {{item}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.teacherToneTip}}">
        <view class="ai-section-title">鼓励</view>
        <view class="ai-tone-tip">{{currentAiFeedback.teacherToneTip}}</view>
      </view>
      <view class="ai-caution" wx:if="{{currentAiFeedback.caution}}">{{currentAiFeedback.caution}}</view>
      </view>
    </scroll-view>
  </view>
  <login-gate id="login-gate" />
</view>
