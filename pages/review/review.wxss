page {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
  background: #f5f7fb;
}

.page {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  overflow-x: hidden;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card {
  border-radius: 36rpx;
  padding: 40rpx 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #17352d 0%, #1f4b3f 100%);
  box-shadow: 0 16rpx 42rpx rgba(23, 53, 45, 0.16);
}

.hero-title {
  display: block;
  font-size: var(--font-ui-46, 46rpx);
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc {
  display: block;
  font-size: var(--font-ui-27, 27rpx);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
}

.overview-row {
  margin-top: 24rpx;
  display: flex;
  gap: 18rpx;
}

.overview-card {
  flex: 1;
  min-width: 0;
  border-radius: 28rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.overview-value {
  display: block;
  color: #07c160;
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 900;
}

.blue-value {
  color: #3478f6;
}

.purple-value {
  color: #6b5cff;
}

.overview-label {
  display: block;
  margin-top: 10rpx;
  color: #8a8f99;
  font-size: var(--font-ui-24, 24rpx);
}

.section {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin-top: 32rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: var(--font-ui-34, 34rpx);
  line-height: 1.3;
  color: #111111;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.no-margin {
  margin-bottom: 0;
}

.section-count {
  flex-shrink: 0;
  color: #07c160;
  font-size: 25rpx;
  font-weight: 800;
}

.filter-text {
  display: block;
  color: #7f8794;
  font-size: var(--font-ui-24, 24rpx);
  line-height: 1.45;
  margin-top: 8rpx;
}

.clear-filter-btn {
  flex-shrink: 0;
  width: 150rpx;
  height: 62rpx;
  line-height: 62rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #5568d9;
  background: #eef1ff;
  font-size: var(--font-ui-24, 24rpx);
  font-weight: 900;
}

.feedback-card {
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-hover {
  background: #f7f9fc;
}

.feedback-main {
  min-width: 0;
}

.feedback-title {
  display: block;
  font-size: var(--font-reading-29, 29rpx);
  line-height: 1.35;
  color: #111111;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.feedback-desc {
  display: block;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.55;
  color: #606875;
}

.feedback-arrow {
  flex-shrink: 0;
  color: #a0a7b5;
  font-size: 50rpx;
  line-height: 1;
}

.work-card {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.work-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.work-type {
  min-width: 0;
  color: #222222;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
}

.status-tag {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.saved-tag {
  color: #8a8f99;
  background: #f2f4f7;
}

.synced-tag {
  color: #07c160;
  background: #e8f8ef;
}

.ai-done-status {
  color: #5568d9;
  background: #eef1ff;
}

.error-status {
  color: #d84d4d;
  background: #fff0f0;
}

.blocked-status {
  color: #8a6d1f;
  background: #fff7dc;
}

.work-body {
  margin-bottom: 18rpx;
}

.work-title {
  display: block;
  color: #222222;
  font-size: var(--font-ui-31, 31rpx);
  line-height: 1.45;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.work-subtitle {
  display: -webkit-box;
  overflow: hidden;
  color: #606875;
  font-size: var(--font-ui-26, 26rpx);
  line-height: 1.6;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.work-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #9aa1aa;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.5;
}

.ai-tip {
  display: block;
  margin-top: 16rpx;
  color: #8a8f99;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.45;
}

.status-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.state-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: var(--font-ui-21, 21rpx);
  font-weight: 800;
}

.public-status {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #16c784;
  background: #eaf8f0;
  font-size: var(--font-ui-22, 22rpx);
  font-weight: 900;
}

.work-list {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.work-actions {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin-top: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.work-action-row {
  display: grid;
  gap: 16rpx;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.work-action-row.primary-row {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
}

.work-action-row.secondary-row {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
  margin-top: 16rpx;
}

.work-action-btn {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

button.work-action-btn::after {
  border: none;
}

.primary-row .work-action-btn {
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 10rpx;
  border-radius: 36rpx;
  font-size: var(--font-ui-28, 28rpx);
  font-weight: 800;
}

.secondary-row .work-action-btn {
  height: 66rpx;
  line-height: 66rpx;
  padding: 0 6rpx;
  border-radius: 32rpx;
  font-size: var(--font-ui-25, 25rpx);
  font-weight: 800;
}

.play-btn {
  color: #2f6fe4;
  background: #eef4ff;
}

.feedback-btn {
  color: #ffffff;
  background: #4f63e6;
}

.share-btn {
  color: #3458c8;
  background: #f1f5ff;
}

.teacher-feedback-btn {
  color: #17352d;
  background: #eaf8f0;
}

.teacher-ready-btn {
  color: #17352d;
  background: #eaf8f0;
}

.teacher-pending-btn {
  color: #6f7885;
  background: #f2f4f7;
}

.teacher-done-btn {
  color: #17352d;
  background: #eaf8f0;
}

.public-btn {
  color: #19b87a;
  background: #eaf8f0;
}

.unpublic-btn {
  color: #8a6a12;
  background: #fff6d8;
}

.delete-btn {
  color: #d85050;
  background: #fdeeee;
}

.feedback-ai-btn {
  color: #ffffff;
  background: #5167e8;
}

.feedback-pending-btn {
  color: #8a8f99;
  background: #edf1f6;
}

.feedback-generating-btn {
  opacity: 0.75;
  color: #4f63e6;
  background: #eef2ff;
}

.feedback-done-btn {
  color: #5568d9;
  background: #eef1ff;
}

.feedback-blocked-btn {
  color: #8a6a12;
  background: #fff6d8;
}

.feedback-error-btn {
  color: #d84d4d;
  background: #fff0f0;
}

.ai-wait-status,
.ai-pending-status,
.pending-status {
  color: #8a8f99;
  background: #edf1f6;
}

.teacher-ready-tag {
  color: #07c160;
  background: #eaf8ef;
}

.teacher-pending-tag {
  color: #6f7885;
  background: #f2f4f7;
}

.teacher-done-tag {
  color: #07c160;
  background: #e8f8ef;
}

.audio-player {
  margin-top: 16rpx;
  padding: 16rpx 18rpx 10rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #edf1f6;
}

.audio-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7f8794;
  font-size: 22rpx;
  font-weight: 700;
}

.audio-slider {
  margin: 8rpx 0 0;
}

.empty-card {
  border-radius: 32rpx;
  padding: 52rpx 34rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.empty-title {
  display: block;
  color: #111111;
  font-size: var(--font-reading-31, 31rpx);
  line-height: 1.4;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.empty-desc {
  display: block;
  color: #8a8f99;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.55;
  margin-bottom: 28rpx;
}

.empty-btn {
  width: 240rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0 auto;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #07c160;
  font-size: var(--font-ui-27, 27rpx);
  font-weight: 900;
}

.ai-feedback-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(17, 24, 39, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

.ai-feedback-panel {
  width: 100%;
  max-height: 82vh;
  border-radius: 28rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 28rpx 70rpx rgba(15, 23, 42, 0.22);
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.ai-feedback-header {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eef0f4;
  box-sizing: border-box;
  flex-shrink: 0;
}

.ai-feedback-title {
  color: #111827;
  font-size: var(--font-reading-34, 34rpx);
  font-weight: 900;
}

.ai-feedback-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  color: #8a92a3;
  background: #f3f5f8;
  font-size: 36rpx;
  box-sizing: border-box;
}

.ai-feedback-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.ai-feedback-content {
  width: 100%;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ai-feedback-content > .ai-generated-notice {
  margin: 0 0 20rpx;
}

.ai-mode-notice {
  margin: 0 0 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.5;
}

.ai-mode-metadata {
  background: #eef4ff;
  color: #3478f6;
}

.ai-mode-transcript {
  background: #eef8f2;
  color: #07c160;
}

.ai-mode-no-speech {
  background: #fff7e6;
  color: #9a6400;
}

.ai-section {
  margin-bottom: 26rpx;
}

.ai-section-title {
  margin-bottom: 10rpx;
  color: #24315f;
  font-size: var(--font-ui-27, 27rpx);
  font-weight: 900;
}

.ai-section-text,
.ai-list-item {
  color: #3f4654;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.65;
  overflow-wrap: break-word;
  word-break: break-word;
}

.ai-list-item {
  margin-bottom: 8rpx;
}

.ai-dimension-item {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f7f9fc;
}

.ai-dimension-item:last-child {
  margin-bottom: 0;
}

.ai-dimension-row {
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-dimension-name {
  color: #24315f;
  font-size: var(--font-ui-26, 26rpx);
  font-weight: 800;
}

.ai-dimension-score {
  flex-shrink: 0;
  color: #5568d9;
  font-size: 25rpx;
  font-weight: 900;
}

.ai-caution {
  margin: 6rpx 0 0;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #fff7e6;
  color: #9a6400;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.55;
  overflow-wrap: break-word;
  word-break: break-word;
}

.ai-tone-tip {
  color: #5568d9;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.55;
  overflow-wrap: break-word;
  word-break: break-word;
}
