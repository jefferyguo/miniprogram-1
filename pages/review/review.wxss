page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card {
  border-radius: 36rpx;
  padding: 40rpx 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #17352d 0%, #1f4b3f 100%);
  box-shadow: 0 16rpx 42rpx rgba(23, 53, 45, 0.16);
}

.hero-title {
  display: block;
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc {
  display: block;
  font-size: 27rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
}

.overview-row {
  margin-top: 24rpx;
  display: flex;
  gap: 18rpx;
}

.overview-card {
  flex: 1;
  min-width: 0;
  border-radius: 28rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.overview-value {
  display: block;
  color: #07c160;
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 900;
}

.blue-value {
  color: #3478f6;
}

.purple-value {
  color: #6b5cff;
}

.overview-label {
  display: block;
  margin-top: 10rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.3;
  color: #111111;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.no-margin {
  margin-bottom: 0;
}

.section-count {
  flex-shrink: 0;
  color: #07c160;
  font-size: 25rpx;
  font-weight: 800;
}

.filter-text {
  display: block;
  color: #7f8794;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 8rpx;
}

.clear-filter-btn {
  flex-shrink: 0;
  width: 150rpx;
  height: 62rpx;
  line-height: 62rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #5568d9;
  background: #eef1ff;
  font-size: 24rpx;
  font-weight: 900;
}

.feedback-card {
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-hover {
  background: #f7f9fc;
}

.feedback-main {
  min-width: 0;
}

.feedback-title {
  display: block;
  font-size: 29rpx;
  line-height: 1.35;
  color: #111111;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.feedback-desc {
  display: block;
  font-size: 25rpx;
  line-height: 1.55;
  color: #606875;
}

.feedback-arrow {
  flex-shrink: 0;
  color: #a0a7b5;
  font-size: 50rpx;
  line-height: 1;
}

.work-card {
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.work-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.work-type {
  min-width: 0;
  color: #222222;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
}

.status-tag {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.pending-status {
  color: #8a8f99;
  background: #f2f4f7;
}

.reviewed-status {
  color: #07c160;
  background: #e8f8ef;
}

.ai-done-status {
  color: #5568d9;
  background: #eef1ff;
}

.teacher-done-status {
  color: #07c160;
  background: #e8f8ef;
}

.error-status {
  color: #d84d4d;
  background: #fff0f0;
}

.blocked-status {
  color: #8a6d1f;
  background: #fff7dc;
}

.work-body {
  margin-bottom: 18rpx;
}

.work-title {
  display: block;
  color: #222222;
  font-size: 31rpx;
  line-height: 1.45;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.work-subtitle {
  display: -webkit-box;
  overflow: hidden;
  color: #606875;
  font-size: 26rpx;
  line-height: 1.6;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.work-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #9aa1aa;
  font-size: 24rpx;
  line-height: 1.5;
}

.ai-tip {
  display: block;
  margin-top: 16rpx;
  color: #8a8f99;
  font-size: 24rpx;
  line-height: 1.45;
}

.work-actions {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.play-btn,
.feedback-btn,
.teacher-feedback-btn {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.play-btn {
  color: #3478f6;
  background: #eef4ff;
}

.feedback-btn {
  color: #07c160;
  background: #eaf8f0;
}

.teacher-feedback-btn {
  color: #17352d;
  background: #eaf8f0;
}

.feedback-ai-btn {
  color: #ffffff;
  background: #5568d9;
}

.feedback-pending-btn {
  color: #8a8f99;
  background: #edf1f6;
}

.feedback-done-btn {
  color: #5568d9;
  background: #eef1ff;
}

.feedback-blocked-btn {
  color: #8a6d1f;
  background: #fff7dc;
}

.feedback-error-btn {
  color: #d84d4d;
  background: #fff0f0;
}

.empty-card {
  border-radius: 32rpx;
  padding: 52rpx 34rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.empty-title {
  display: block;
  color: #111111;
  font-size: 31rpx;
  line-height: 1.4;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.empty-desc {
  display: block;
  color: #8a8f99;
  font-size: 25rpx;
  line-height: 1.55;
  margin-bottom: 28rpx;
}

.empty-btn {
  width: 240rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0 auto;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #07c160;
  font-size: 27rpx;
  font-weight: 900;
}
