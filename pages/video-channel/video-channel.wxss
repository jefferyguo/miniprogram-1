page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card {
  border-radius: 36rpx;
  padding: 40rpx 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #07c160, #3478f6);
  box-shadow: 0 16rpx 42rpx rgba(7, 193, 96, 0.20);
}

.hero-title {
  display: block;
  font-size: var(--font-ui-42, 42rpx);
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc,
.paragraph,
.qr-tip {
  display: block;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.55;
}

.hero-desc {
  opacity: 0.9;
}

.content-card,
.qr-card {
  margin-top: 26rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  color: #111111;
  font-size: var(--font-ui-33, 33rpx);
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 16rpx;
}

.paragraph,
.qr-tip {
  color: #8a8f99;
}

.qr-card {
  text-align: center;
}

.qr-image,
.qr-placeholder {
  width: 420rpx;
  height: 420rpx;
  display: block;
  margin: 0 auto;
  border-radius: 24rpx;
}

.qr-placeholder {
  line-height: 420rpx;
  color: #8a8f99;
  background: #f5f7fb;
  font-size: 27rpx;
}

.qr-tip {
  margin-top: 24rpx;
  text-align: center;
}

.primary-btn {
  height: 82rpx;
  line-height: 82rpx;
  margin-top: 30rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #07c160;
  font-size: var(--font-ui-28, 28rpx);
  font-weight: 900;
}
