<view class="page">
  <view class="hero-card">
    <text class="hero-title">杨勤口才训练KEEP 教师端</text>
    <text class="hero-desc">教师点评与学员作品管理</text>
  </view>

  <view class="login-card">
    <text class="card-title">教师端登录</text>
    <input
      class="password-input"
      password
      placeholder="请输入教师口令"
      placeholder-class="input-placeholder"
      value="{{password}}"
      bindinput="onPasswordInput"
    />
    <button class="primary-btn" bindtap="enterTeacherHome">进入教师端</button>
  </view>

  <text class="page-tip">该页面仅供老师使用</text>
</view>
