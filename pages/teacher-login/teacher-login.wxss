page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card {
  border-radius: 36rpx;
  padding: 46rpx 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #07c160, #3478f6);
  box-shadow: 0 16rpx 42rpx rgba(7, 193, 96, 0.20);
}

.hero-title {
  display: block;
  font-size: 42rpx;
  line-height: 1.32;
  font-weight: 900;
  margin-bottom: 14rpx;
}

.hero-desc {
  display: block;
  font-size: 27rpx;
  line-height: 1.5;
  opacity: 0.9;
}

.login-card {
  margin-top: 32rpx;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.35;
  color: #111111;
  font-weight: 900;
  margin-bottom: 28rpx;
}

.password-input {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  color: #111111;
  background: #f5f7fb;
  font-size: 28rpx;
}

.input-placeholder {
  color: #a3a8b2;
}

.primary-btn {
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 28rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #07c160;
  font-size: 29rpx;
  font-weight: 900;
}

.page-tip {
  display: block;
  margin-top: 32rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 25rpx;
}
