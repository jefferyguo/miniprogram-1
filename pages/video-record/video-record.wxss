page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.top-card {
  display: flex;
  align-items: center;
  margin-bottom: 26rpx;
}

.title {
  display: block;
  font-size: var(--font-ui-46, 46rpx);
  line-height: 1.25;
  font-weight: 900;
  color: #111111;
  margin-bottom: 10rpx;
}

.camera-label {
  display: block;
  font-size: var(--font-ui-26, 26rpx);
  color: #8a8f99;
}

.preview-box {
  position: relative;
  width: 100%;
  height: 840rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #111111;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.10);
}

.camera-preview,
.video-preview {
  width: 100%;
  height: 100%;
}

.camera-toolbar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 5;
}

.camera-status {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #ffffff;
  font-size: var(--font-ui-24, 24rpx);
  font-weight: 800;
}

.switch-camera-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #3478f6;
  font-size: 24rpx;
  font-weight: 900;
}

.disabled {
  opacity: 0.45;
}

.prompt-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  z-index: 20;
  padding: 22rpx 24rpx 20rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.58);
  backdrop-filter: blur(12rpx);
}

.prompt-top {
  width: 100%;
  margin-bottom: 14rpx;
}

.prompt-title-wrap {
  width: 100%;
  min-width: 0;
}

.prompt-title {
  display: block;
  width: 100%;
  color: #ffffff;
  font-size: var(--font-reading-30, 30rpx);
  font-weight: 800;
  line-height: 1.35;
  white-space: normal;
  word-break: break-all;
}

.prompt-subtitle {
  display: block;
  color: rgba(255, 255, 255, 0.76);
  font-size: var(--font-ui-24, 24rpx);
  line-height: 1.35;
  margin-top: 6rpx;
}

.prompt-scroll {
  width: 100%;
  height: 260rpx;
  max-height: 260rpx;
  min-height: 120rpx;
  box-sizing: border-box;
}

.prompt-text {
  display: block;
  width: 100%;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.65;
  font-weight: 600;
  white-space: normal;
  word-break: break-all;
  box-sizing: border-box;
  text-align: left;
}

.prompt-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
  width: 100%;
}

.prompt-action-btn {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1f2937;
  font-size: var(--font-ui-24, 24rpx);
  font-weight: 700;
  margin: 0;
  padding: 0;
}

.prompt-action-btn.small {
  flex: 0 0 110rpx;
}

.prompt-action-btn::after {
  border: none;
}

.prompt-show-btn {
  position: absolute;
  left: 50%;
  bottom: 36rpx;
  transform: translateX(-50%);
  z-index: 21;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.62);
  color: #ffffff;
  font-size: var(--font-ui-24, 24rpx);
  font-weight: 700;
}

.camera-switch-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.camera-switch-text {
  color: #ffffff;
  font-size: 28rpx;
  background: rgba(0, 0, 0, 0.45);
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
}

.status-card {
  margin-top: 28rpx;
  border-radius: 30rpx;
  padding: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.status-title {
  display: block;
  font-size: var(--font-ui-34, 34rpx);
  line-height: 1.3;
  color: #111111;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.status-desc {
  display: block;
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.5;
  color: #8a8f99;
}

.status-desc.warning {
  color: #d97706;
  font-weight: 700;
}

.actions {
  margin-top: 28rpx;
}

.two-actions {
  display: flex;
  gap: 18rpx;
}

.record-btn,
.reset-btn,
.use-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  font-size: var(--font-ui-29, 29rpx);
  font-weight: 900;
}

.record-btn {
  width: 100%;
  background: #07c160;
  color: #ffffff;
}

.stop-btn {
  background: #ff4d4f;
}

.reset-btn {
  flex: 1;
  color: #3478f6;
  background: #ffffff;
  border: 2rpx solid rgba(52, 120, 246, 0.28);
}

.use-btn {
  flex: 1;
  color: #ffffff;
  background: #07c160;
}
