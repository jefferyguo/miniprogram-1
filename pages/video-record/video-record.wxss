page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.top-card {
  display: flex;
  align-items: center;
  margin-bottom: 26rpx;
}

.title {
  display: block;
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #111111;
  margin-bottom: 10rpx;
}

.camera-label {
  display: block;
  font-size: 26rpx;
  color: #8a8f99;
}

.preview-box {
  position: relative;
  width: 100%;
  height: 840rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #111111;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.10);
}

.camera-preview,
.video-preview {
  width: 100%;
  height: 100%;
}

.camera-toolbar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 5;
}

.camera-status {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.switch-camera-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #3478f6;
  font-size: 24rpx;
  font-weight: 900;
}

.disabled {
  opacity: 0.45;
}

.prompt-overlay {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  max-height: 360rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(12rpx);
  color: #ffffff;
  z-index: 6;
}

.prompt-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.prompt-heading {
  min-width: 0;
}

.prompt-title {
  display: block;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.prompt-subtitle {
  display: block;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.35;
  margin-top: 6rpx;
}

.prompt-tools {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.prompt-tool-btn {
  min-width: 64rpx;
  height: 52rpx;
  line-height: 52rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1f2937;
  font-size: 22rpx;
  font-weight: 700;
}

.prompt-tool-btn::after {
  border: none;
}

.prompt-scroll {
  height: 210rpx;
  max-height: 210rpx;
  overflow: hidden;
}

.prompt-content {
  display: block;
  color: #ffffff;
  line-height: 1.75;
  font-weight: 600;
  white-space: pre-wrap;
}

.prompt-requirement {
  display: block;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  line-height: 1.6;
}

.show-prompt-btn {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.48);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  z-index: 7;
}

.camera-switch-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.camera-switch-text {
  color: #ffffff;
  font-size: 28rpx;
  background: rgba(0, 0, 0, 0.45);
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
}

.status-card {
  margin-top: 28rpx;
  border-radius: 30rpx;
  padding: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.status-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.3;
  color: #111111;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.status-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  color: #8a8f99;
}

.actions {
  margin-top: 28rpx;
}

.two-actions {
  display: flex;
  gap: 18rpx;
}

.record-btn,
.reset-btn,
.use-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  font-size: 29rpx;
  font-weight: 900;
}

.record-btn {
  width: 100%;
  background: #07c160;
  color: #ffffff;
}

.stop-btn {
  background: #ff4d4f;
}

.reset-btn {
  flex: 1;
  color: #3478f6;
  background: #ffffff;
  border: 2rpx solid rgba(52, 120, 246, 0.28);
}

.use-btn {
  flex: 1;
  color: #ffffff;
  background: #07c160;
}
