page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card {
  min-height: 220rpx;
  border-radius: 36rpx;
  padding: 38rpx 34rpx;
  box-sizing: border-box;
  color: #ffffff;
  display: flex;
  align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.10);
}

.extra-dailyQuote {
  background: linear-gradient(135deg, #ffc94d, #ffb020);
}

.extra-dailyQuote .hero-icon-wrap {
  background: #fff7e8;
}

.extra-dailyQuote .hero-icon {
  color: #f5a623;
}

.extra-randomTopic {
  background: linear-gradient(135deg, #4f7cff, #3478f6);
}

.extra-tongueTwister {
  background: linear-gradient(135deg, #ff8a4c, #ff5f6d);
}

.hero-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 26rpx;
  flex-shrink: 0;
}

.hero-icon {
  font-size: 44rpx;
  line-height: 1;
  font-weight: 900;
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.hero-title {
  display: block;
  font-size: var(--font-ui-46, 46rpx);
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc {
  display: block;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.55;
  opacity: 0.94;
}

.content-card,
.record-card,
.history-card {
  margin-top: 24rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.today-card {
  padding-bottom: 34rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.eyebrow {
  display: block;
  font-size: var(--font-ui-23, 23rpx);
  color: #8a8f99;
  margin-bottom: 8rpx;
}

.section-title {
  display: block;
  font-size: var(--font-ui-34, 34rpx);
  line-height: 1.3;
  font-weight: 900;
  color: #111111;
}

.change-btn {
  flex-shrink: 0;
  min-width: 132rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0 24rpx;
  background: #eaf8f0;
  color: #07c160;
  font-size: var(--font-ui-24, 24rpx);
  font-weight: 800;
}

.content {
  display: block;
  font-size: var(--font-reading-35, 35rpx);
  line-height: 1.78;
  color: #222222;
  font-weight: 800;
  text-align: left;
}

.content-tag {
  display: inline-block;
  margin-bottom: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #07c160;
  background: #eaf8f0;
  font-size: 23rpx;
  font-weight: 800;
}

.usage-tip {
  display: block;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  color: #5f6673;
  background: #f5f7fb;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.5;
}

.content-tip {
  display: block;
  margin-top: 22rpx;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.5;
  color: #8a8f99;
}

.record-desc {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.5;
  color: #8a8f99;
}

.record-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
}

.audio-btn,
.video-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  font-size: var(--font-ui-28, 28rpx);
  font-weight: 900;
  color: #ffffff;
}

.audio-btn {
  background: #07c160;
}

.video-btn {
  background: #3478f6;
}

.stop-btn {
  background: #ff4d4f;
}

.disabled-btn {
  opacity: 0.42;
}

.record-status {
  display: block;
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #fff2f2;
  font-size: var(--font-ui-27, 27rpx);
  line-height: 1.45;
  color: #ff4d4f;
  font-weight: 800;
}

.history-card .section-title {
  margin-bottom: 20rpx;
}

.work-item {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  margin-bottom: 18rpx;
}

.work-item:last-child {
  margin-bottom: 0;
}

.work-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.work-title {
  font-size: var(--font-ui-28, 28rpx);
  color: #111111;
  font-weight: 900;
}

.work-status {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: var(--font-ui-21, 21rpx);
  font-weight: 800;
  flex-shrink: 0;
}

.saved-tag {
  background: #edf1f6;
  color: #8a8f99;
}

.synced-tag {
  color: #07c160;
  background: #eaf8ef;
}

.public-status {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #16c784;
  background: #eaf8f0;
  font-size: var(--font-ui-22, 22rpx);
  font-weight: 900;
}

.work-content {
  display: -webkit-box;
  margin-top: 14rpx;
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.55;
  color: #333333;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.work-meta,
.empty {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.5;
  color: #8a8f99;
}

.work-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.play-small,
.delete-small,
.feedback-small,
.teacher-small {
  flex: 1;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  font-size: var(--font-ui-23, 23rpx);
  font-weight: 800;
}

.play-small {
  background: #eef4ff;
  color: #3478f6;
}

.delete-small {
  background: #fff0f0;
  color: #d84d4d;
}

.primary-actions,
.secondary-actions {
  flex-wrap: wrap;
}

.secondary-actions {
  margin-top: 14rpx;
}

.public-btn,
.unpublic-btn {
  flex: 1;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  font-size: var(--font-ui-24, 24rpx);
  font-weight: 800;
}

.public-btn {
  color: #16c784;
  background: #eaf8f0;
}

.unpublic-btn {
  color: #d84d4d;
  background: #fff0f0;
}

.feedback-ai-btn {
  color: #ffffff;
  background: #5568d9;
}

.feedback-pending-btn {
  color: #8a8f99;
  background: #edf1f6;
}

.feedback-generating-btn {
  opacity: 0.75;
  color: #4f63e6;
  background: #eef2ff;
}

.feedback-done-btn {
  color: #5568d9;
  background: #eef1ff;
}

.feedback-blocked-btn {
  color: #8a6d1f;
  background: #fff7dc;
}

.feedback-error-btn {
  color: #d84d4d;
  background: #fff0f0;
}

.teacher-ready-btn {
  color: #17352d;
  background: #eaf8f0;
}

.teacher-pending-btn {
  color: #6f7885;
  background: #f2f4f7;
}

.teacher-done-btn {
  color: #17352d;
  background: #eaf8f0;
}

.status-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.state-pill {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: var(--font-ui-21, 21rpx);
  font-weight: 800;
}

.ai-wait-tag,
.ai-pending-tag {
  color: #8a8f99;
  background: #edf1f6;
}

.ai-generating-tip {
  display: block;
  margin: 12rpx 0 0;
  color: #5568d9;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.45;
}

.ai-done-tag {
  color: #5568d9;
  background: #eef1ff;
}

.ai-error-tag {
  color: #d84d4d;
  background: #fff0f0;
}

.ai-blocked-tag {
  color: #8a6d1f;
  background: #fff7dc;
}

.teacher-ready-tag {
  color: #07c160;
  background: #eaf8ef;
}

.teacher-pending-tag {
  color: #6f7885;
  background: #f2f4f7;
}

.teacher-done-tag {
  color: #07c160;
  background: #eaf8ef;
}

.audio-player {
  margin-top: 16rpx;
  padding: 16rpx 18rpx 10rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #edf1f6;
}

.audio-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7f8794;
  font-size: 22rpx;
  font-weight: 700;
}

.audio-slider {
  margin: 8rpx 0 0;
}

.ai-feedback-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(17, 24, 39, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

.ai-feedback-panel {
  width: 100%;
  max-height: 82vh;
  border-radius: 28rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 28rpx 70rpx rgba(15, 23, 42, 0.22);
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.ai-feedback-header {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eef0f4;
  box-sizing: border-box;
  flex-shrink: 0;
}

.ai-feedback-title {
  color: #111827;
  font-size: var(--font-reading-34, 34rpx);
  font-weight: 900;
}

.ai-feedback-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  color: #8a92a3;
  background: #f3f5f8;
  font-size: 36rpx;
  box-sizing: border-box;
}

.ai-feedback-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.ai-feedback-content {
  width: 100%;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ai-feedback-content > .ai-generated-notice {
  margin: 0 0 20rpx;
}

.ai-mode-notice {
  margin: 0 0 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.5;
}

.ai-mode-metadata {
  background: #eef4ff;
  color: #3478f6;
}

.ai-mode-transcript {
  background: #eef8f2;
  color: #07c160;
}

.ai-mode-no-speech {
  background: #fff7e6;
  color: #9a6400;
}

.ai-section {
  margin-bottom: 26rpx;
}

.ai-section-title {
  margin-bottom: 10rpx;
  color: #24315f;
  font-size: var(--font-ui-27, 27rpx);
  font-weight: 900;
}

.ai-section-text,
.ai-list-item {
  color: #3f4654;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.65;
  overflow-wrap: break-word;
  word-break: break-word;
}

.ai-list-item {
  margin-bottom: 8rpx;
}

.ai-dimension-item {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f7f9fc;
}

.ai-dimension-item:last-child {
  margin-bottom: 0;
}

.ai-dimension-row {
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-dimension-name {
  color: #24315f;
  font-size: var(--font-ui-26, 26rpx);
  font-weight: 800;
}

.ai-dimension-score {
  flex-shrink: 0;
  color: #5568d9;
  font-size: 25rpx;
  font-weight: 900;
}

.ai-caution {
  margin: 6rpx 0 0;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #fff7e6;
  color: #9a6400;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.55;
  overflow-wrap: break-word;
  word-break: break-word;
}

.ai-tone-tip {
  color: #5568d9;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.55;
  overflow-wrap: break-word;
  word-break: break-word;
}
