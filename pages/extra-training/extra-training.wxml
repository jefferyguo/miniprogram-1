<page-meta page-style="{{showAiFeedbackPanel ? 'overflow: hidden;' : ''}}"></page-meta>

<view class="page">
  <view class="hero-card {{heroClass}}">
    <view class="hero-icon-wrap">
      <text class="hero-icon">{{icon}}</text>
    </view>
    <view class="hero-copy">
      <text class="hero-title">{{title}}</text>
      <text class="hero-desc">{{desc}}</text>
    </view>
  </view>

  <view class="content-card today-card">
    <view class="card-head">
      <view>
        <text class="eyebrow">今日内容</text>
        <text class="section-title">{{contentTitle}}</text>
      </view>
      <button class="change-btn" bindtap="changeContent">{{changeButtonText}}</button>
    </view>
    <text wx:if="{{contentCategory}}" class="content-tag">{{contentCategory}}</text>
    <text class="content">{{content}}</text>
    <text wx:if="{{contentUsageTip}}" class="usage-tip">练习提示：{{contentUsageTip}}</text>
    <text class="content-tip">{{contentTip}}</text>
  </view>

  <view class="record-card">
    <text class="section-title">录制操作</text>
    <text class="record-desc">录一段声音或视频，保存你的训练作品</text>

    <view class="record-actions">
      <button
        class="audio-btn {{isAudioRecording ? 'stop-btn' : ''}} {{isVideoRecording ? 'disabled-btn' : ''}}"
        disabled="{{isVideoRecording}}"
        bindtap="toggleAudio"
      >{{isAudioRecording ? '停止录音' : '开始录音'}}</button>

      <button
        class="video-btn {{isVideoRecording ? 'stop-btn' : ''}} {{isAudioRecording ? 'disabled-btn' : ''}}"
        disabled="{{isAudioRecording}}"
        bindtap="toggleVideo"
      >{{isVideoRecording ? '停止录像' : '开始录像'}}</button>
    </view>

    <text wx:if="{{isRecording}}" class="record-status">
      正在{{recordingTypeText}}中 {{recordingTimeText}}
    </text>
  </view>

  <view class="history-card">
    <text class="section-title">作品历史</text>

    <view wx:if="{{hasDrafts}}">
      <view class="work-item" wx:for="{{drafts}}" wx:key="id">
        <view class="work-head">
          <text class="work-title">{{item.typeIcon}} {{item.typeTitle}}</text>
          <text class="work-status {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <text wx:if="{{item.isPublic}}" class="public-status">已发布到广场</text>
        <text class="work-meta">{{item.duration}} · {{item.createdAt}}</text>
        <text class="work-content">{{item.content}}</text>

        <view class="status-row">
          <text class="state-pill {{item.aiStatusClass}}">{{item.aiStatusText}}</text>
        </view>
        <text wx:if="{{item.aiGeneratingTip}}" class="ai-generating-tip">{{item.aiGeneratingTip}}</text>

        <view class="work-actions primary-actions">
          <button class="play-small" data-id="{{item.id}}" catchtap="playWork">
            <block wx:if="{{item.type === 'audio' && audioPlayer.activeKey === item.audioKey && audioPlayer.isPlaying}}">暂停</block>
            <block wx:elif="{{item.type === 'audio' && audioPlayer.activeKey === item.audioKey && audioPlayer.isPaused}}">继续</block>
            <block wx:else>{{item.actionText}}</block>
          </button>
          <button
            class="feedback-small {{item.feedbackActionClass}}"
            disabled="{{item.feedbackActionDisabled}}"
            data-id="{{item.id}}"
            catchtap="handleAiFeedbackAction"
          >{{item.feedbackActionText}}</button>
        </view>

        <view class="audio-player" wx:if="{{item.type === 'audio' && audioPlayer.activeKey === item.audioKey}}">
          <view class="audio-time-row">
            <text>{{audioPlayer.currentText}}</text>
            <text>{{audioPlayer.durationText}}</text>
          </view>
          <slider
            class="audio-slider"
            min="0"
            max="100"
            step="1"
            value="{{audioPlayer.progress}}"
            activeColor="#3478f6"
            backgroundColor="#dfe6f2"
            block-size="14"
            bindchange="onAudioSliderChange"
          />
        </view>

        <view class="work-actions secondary-actions">
          <button
            wx:if="{{!item.isPublic}}"
            class="public-btn"
            data-id="{{item.id}}"
            catchtap="publishDraftToSquare"
          >发布广场</button>
          <button
            wx:if="{{item.isPublic}}"
            class="unpublic-btn"
            data-id="{{item.id}}"
            catchtap="unpublishDraftFromSquare"
          >取消公开</button>
          <button class="delete-small" data-id="{{item.id}}" catchtap="deleteDraft">删除</button>
        </view>
      </view>
    </view>

    <view class="empty" wx:else>
      <text>还没有录音或录像作品，先完成一次加练吧。</text>
    </view>
  </view>
</view>
<member-benefit-modal id="memberBenefitModal" />

<view class="ai-feedback-mask" wx:if="{{showAiFeedbackPanel}}" bindtap="closeAiFeedbackPanel">
  <view class="ai-feedback-panel" catchtap="noop">
    <view class="ai-feedback-header">
      <text class="ai-feedback-title">{{currentAiFeedback.title || 'AI点评'}}</text>
      <text class="ai-feedback-close" bindtap="closeAiFeedbackPanel">×</text>
    </view>

    <scroll-view
      class="ai-feedback-scroll"
      scroll-y="{{true}}"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      scroll-top="{{aiFeedbackScrollTop}}"
    >
      <view class="ai-feedback-content">
      <view class="ai-generated-notice">AI生成内容，仅供表达训练参考</view>
      <view class="ai-mode-notice {{currentAiFeedback.noticeClass}}" wx:if="{{currentAiFeedback.noticeText}}">
        {{currentAiFeedback.noticeText}}
      </view>

      <view class="ai-section" wx:if="{{currentAiFeedback.summary}}">
        <view class="ai-section-title">综合评价</view>
        <view class="ai-section-text">{{currentAiFeedback.summary}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.basis}}">
        <view class="ai-section-title">点评依据</view>
        <view class="ai-section-text">{{currentAiFeedback.basis}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.dimensionScores.length}}">
        <view class="ai-section-title">维度评分</view>
        <view class="ai-dimension-item" wx:for="{{currentAiFeedback.dimensionScores}}" wx:key="name">
          <view class="ai-dimension-row">
            <text class="ai-dimension-name">{{item.name}}</text>
            <text class="ai-dimension-score">{{item.score}}分</text>
          </view>
          <view class="ai-section-text">{{item.comment}}</view>
        </view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.contentReview}}">
        <view class="ai-section-title">内容表现</view>
        <view class="ai-section-text">{{currentAiFeedback.contentReview}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.voiceStateReview}}">
        <view class="ai-section-title">声音状态</view>
        <view class="ai-section-text">{{currentAiFeedback.voiceStateReview}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.strengths.length}}">
        <view class="ai-section-title">可以保留的做法</view>
        <view wx:for="{{currentAiFeedback.strengths}}" wx:key="*this" class="ai-list-item">{{index + 1}}. {{item}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.improvements.length}}">
        <view class="ai-section-title">下次提升重点</view>
        <view wx:for="{{currentAiFeedback.improvements}}" wx:key="*this" class="ai-list-item">{{index + 1}}. {{item}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.nextPractice.length}}">
        <view class="ai-section-title">下一次训练动作</view>
        <view wx:for="{{currentAiFeedback.nextPractice}}" wx:key="*this" class="ai-list-item">{{index + 1}}. {{item}}</view>
      </view>
      <view class="ai-section" wx:if="{{currentAiFeedback.teacherToneTip}}">
        <view class="ai-section-title">鼓励</view>
        <view class="ai-tone-tip">{{currentAiFeedback.teacherToneTip}}</view>
      </view>
      <view class="ai-caution" wx:if="{{currentAiFeedback.caution}}">{{currentAiFeedback.caution}}</view>
      </view>
    </scroll-view>
  </view>
</view>
