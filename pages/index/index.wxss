page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 64rpx 32rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.placeholder-card {
  border-radius: 34rpx;
  padding: 52rpx 36rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.title {
  display: block;
  font-size: var(--font-ui-48, 48rpx);
  font-weight: 900;
  color: #111111;
  margin-bottom: 18rpx;
}

.desc {
  display: block;
  font-size: var(--font-reading-28, 28rpx);
  line-height: 1.6;
  color: #666666;
  margin-bottom: 34rpx;
}

.primary-btn {
  width: 100%;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  background: linear-gradient(135deg, #07c160, #20d98b);
  color: #ffffff;
  font-size: var(--font-ui-29, 29rpx);
  font-weight: 900;
}
