page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 56rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  color: #111111;
  margin-bottom: 14rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: #7f8794;
}

.stats-row {
  display: flex;
  gap: 20rpx;
}

.stats-card,
.section-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #edf1f6;
}

.stats-card {
  flex: 1;
  min-height: 174rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.stats-num {
  display: block;
  font-size: 58rpx;
  line-height: 1;
  color: #07c160;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.small-num {
  font-size: 42rpx;
  line-height: 1.25;
}

.stats-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
}

.section-card {
  margin-top: 28rpx;
  padding: 32rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #111111;
  margin-bottom: 24rpx;
}

.progress-item {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.progress-item:last-child {
  margin-bottom: 0;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.progress-title {
  font-size: 28rpx;
  color: #111111;
  font-weight: 800;
}

.progress-count {
  font-size: 26rpx;
  color: #07c160;
  font-weight: 900;
}

.progress-bar {
  height: 16rpx;
  border-radius: 999rpx;
  background: #edf1f6;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #07c160, #20d98b);
}

.record-item {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  margin-bottom: 18rpx;
  border-bottom: none;
}

.record-item:last-child {
  border-bottom: none;
}

.record-title {
  display: block;
  font-size: 29rpx;
  color: #111111;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.record-desc,
.empty {
  display: block;
  font-size: 26rpx;
  color: #7f8794;
  line-height: 1.5;
}

.extra-summary {
  border-radius: 24rpx;
  padding: 26rpx;
  background: #fff8e8;
  margin-bottom: 24rpx;
}

.extra-total {
  display: block;
  font-size: 52rpx;
  line-height: 1;
  color: #ffb020;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.extra-label {
  display: block;
  font-size: 26rpx;
  color: #8a8f99;
}

.extra-stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.extra-stat:last-of-type {
  border-bottom: none;
}

.extra-name {
  font-size: 28rpx;
  color: #111111;
  font-weight: 800;
}

.extra-count {
  font-size: 27rpx;
  color: #07c160;
  font-weight: 900;
}

.extra-recent {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f2f6;
}

.recent-label {
  display: block;
  font-size: 24rpx;
  color: #8a8f99;
  margin-bottom: 12rpx;
}

.extra-empty {
  margin-top: 20rpx;
}
