page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card,
.auth-card,
.contact-card {
  border-radius: 30rpx;
  background: #ffffff;
  border: 1rpx solid #edf1f6;
  box-shadow: 0 14rpx 36rpx rgba(31, 41, 55, 0.05);
  box-sizing: border-box;
}

.hero-card {
  padding: 42rpx 34rpx;
  background: linear-gradient(135deg, #f0fbf6 0%, #eef7ff 100%);
}

.hero-title {
  display: block;
  color: #111827;
  font-size: var(--font-ui-46, 46rpx);
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 14rpx;
}

.hero-desc,
.section-desc {
  display: block;
  color: #687280;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.6;
}

.auth-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.section-title,
.dev-title {
  display: block;
  color: #111827;
  font-size: var(--font-ui-34, 34rpx);
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.phone-auth-btn,
.contact-page-btn {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  margin: 28rpx 0 0;
  padding: 0;
  font-size: var(--font-ui-27, 27rpx);
  font-weight: 900;
}

.phone-auth-btn {
  color: #ffffff;
  background: #16c784;
  position: relative;
  z-index: 1;
}

.phone-status {
  display: block;
  margin-bottom: 14rpx;
  color: #d85b5b;
  font-size: var(--font-ui-27, 27rpx);
  font-weight: 800;
}

.bound-status {
  color: #15966a;
}

.skip-btn {
  height: 68rpx;
  line-height: 68rpx;
  margin: 12rpx 0 0;
  padding: 0;
  color: #8a93a3;
  background: transparent;
  font-size: var(--font-ui-25, 25rpx);
}

.skip-btn::after {
  border: none;
}

.contact-card {
  margin: 28rpx 0 0;
  padding: 36rpx 32rpx 40rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(31, 41, 55, 0.06);
  text-align: center;
}

.contact-title {
  color: #111827;
  font-size: var(--font-ui-32, 32rpx);
  line-height: 1.35;
  font-weight: 800;
}

.contact-desc {
  margin-top: 16rpx;
  color: #7a8494;
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.65;
  text-align: left;
}

.contact-qr,
.contact-qr-placeholder {
  margin: 28rpx auto 0;
  width: 360rpx;
  height: 360rpx;
  border-radius: 20rpx;
  background: #f5f7fb;
}

.contact-qr-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a93a3;
  font-size: 26rpx;
}

.contact-tip {
  margin-top: 16rpx;
  color: #8a93a3;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.45;
}

.contact-page-btn {
  width: 360rpx;
  margin: 28rpx auto 0;
  color: #3478f6;
  background: #eef4ff;
  font-size: var(--font-ui-26, 26rpx);
  font-weight: 700;
}
