page {
  background: #f5f7fb;
}

.historical-note {
  margin: -10rpx 32rpx 24rpx;
  padding: 18rpx 24rpx;
  border: 1rpx solid #dce8e2;
  border-radius: 18rpx;
  color: #557067;
  background: #f4faf7;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.55;
  box-sizing: border-box;
}

.historical-unavailable-card {
  margin: 32rpx;
  padding: 52rpx 36rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(31, 42, 68, 0.06);
  text-align: center;
}

.historical-unavailable-title,
.historical-unavailable-text {
  display: block;
}

.historical-unavailable-title {
  color: #202b3c;
  font-size: var(--font-ui-32, 32rpx);
  font-weight: 800;
}

.historical-unavailable-text {
  margin-top: 16rpx;
  color: #7b8494;
  font-size: var(--font-ui-25, 25rpx);
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.task-hero {
  margin: 32rpx 0 0;
  padding: 44rpx 38rpx;
  border-radius: 32rpx;
  min-height: 230rpx;
  background: linear-gradient(135deg, #1fc96b 0%, #27d68a 100%);
  color: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 20rpx 45rpx rgba(31, 201, 107, 0.22);
}

.module-reading {
  background: linear-gradient(135deg, #4FB99F 0%, #6BC7B2 100%);
}

.module-retell {
  background: linear-gradient(135deg, #6D7FD6 0%, #8A80E8 100%);
}

.module-topic {
  background: linear-gradient(135deg, #E98D7A 0%, #F2A28E 100%);
}

.module-mandarin {
  background: linear-gradient(135deg, #5C9FD6 0%, #78A7E3 100%);
}

.module-name {
  display: block;
  color: rgba(255, 255, 255, 0.86);
  font-size: var(--font-ui-28, 28rpx);
  font-weight: 500;
}

.day-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.hero-main-title {
  display: block;
  margin-top: 28rpx;
  color: #ffffff;
  font-size: var(--font-ui-42, 42rpx);
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: 1rpx;
  word-break: break-word;
}

.content-card,
.material-card,
.record-card,
.feedback-card,
.history-card {
  margin-top: 24rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.material-card {
  background: #fff8e8;
}

.training-content-unavailable {
  padding: 30rpx 0 10rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}

.training-content-message {
  color: #7a8192;
  font-size: var(--font-reading-28, 28rpx);
  line-height: 1.6;
}

.training-content-loading-dot {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(7, 193, 96, 0.18);
  border-top-color: #07c160;
  border-radius: 50%;
  animation: training-content-spin 0.8s linear infinite;
}

@keyframes training-content-spin {
  to {
    transform: rotate(360deg);
  }
}

.training-content-retry {
  margin: 0;
  min-width: 210rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #eaf8f0;
  color: #07c160;
  font-size: var(--font-ui-27, 27rpx);
  font-weight: 700;
}

.training-content-retry::after {
  border: none;
}

.section-title {
  display: block;
  font-size: var(--font-ui-32, 32rpx);
  font-weight: 900;
  color: #111111;
  margin-bottom: 16rpx;
}

.no-margin {
  margin-bottom: 0;
}

.material-text,
.record-status,
.empty {
  display: block;
  font-size: var(--font-reading-28, 28rpx);
  line-height: 1.65;
  color: #666666;
}

.material-text {
  color: #333333;
  white-space: pre-wrap;
  overflow-wrap: break-word;
  word-break: break-word;
}

.material-rich-text {
  color: #333333;
  font-size: var(--font-reading-32, 32rpx);
  line-height: 1.72;
  word-break: break-word;
}

.material-segment {
  display: inline;
  white-space: pre-wrap;
}

.material-size-small {
  font-size: var(--font-reading-28, 28rpx);
}

.material-size-normal {
  font-size: var(--font-reading-32, 32rpx);
}

.material-size-large {
  font-size: var(--font-reading-36, 36rpx);
}

.material-size-xlarge {
  font-size: var(--font-reading-40, 40rpx);
}

.material-color-default {
  color: #1f2933;
}

.material-color-green {
  color: #0f766e;
}

.material-color-red {
  color: #b91c1c;
}

.material-color-blue {
  color: #1d4ed8;
}

.material-color-gold {
  color: #a16207;
}

.material-bold {
  font-weight: 700;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #07c160;
  margin-top: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: var(--font-reading-28, 28rpx);
  line-height: 1.6;
  color: #666666;
}

.record-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
}

.audio-btn,
.video-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  font-size: var(--font-ui-29, 29rpx);
  font-weight: 900;
}

.audio-btn {
  background: #07c160;
  color: #ffffff;
}

.video-btn {
  background: #3478f6;
  color: #ffffff;
}

.recording-btn {
  background: #ff4d4f;
  color: #ffffff;
  border: none;
}

.disabled-btn {
  opacity: 0.42;
}

.feedback-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.feedback-desc {
  display: block;
  margin-top: 12rpx;
  color: #7f8794;
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.55;
}

.feedback-link-btn {
  flex-shrink: 0;
  width: 210rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #5568d9;
  background: #eef1ff;
  font-size: var(--font-ui-24, 24rpx);
  font-weight: 900;
}

.work-item {
  border-radius: 24rpx;
  padding: 24rpx;
  background: #f8fafc;
  margin-bottom: 20rpx;
}

.work-item:last-child {
  margin-bottom: 0;
}

.work-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: #eef8f2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.work-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.work-name {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.work-title {
  font-size: var(--font-ui-29, 29rpx);
  color: #111111;
  font-weight: 900;
  line-height: 1.35;
}

.work-status {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: var(--font-ui-20, 20rpx);
  font-weight: 800;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.saved-tag {
  color: #8a8f99;
  background: #edf1f6;
}

.synced-tag {
  color: #07c160;
  background: #eaf8ef;
}

.public-status {
  display: inline-block;
  margin-top: 14rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #16c784;
  background: #eaf8f0;
  font-size: var(--font-ui-22, 22rpx);
  font-weight: 900;
}

.work-meta {
  display: block;
  font-size: var(--font-reading-24, 24rpx);
  color: #8a8f99;
  line-height: 1.55;
}

.work-meta-row {
  margin-top: 18rpx;
}

.work-content {
  display: -webkit-box;
  margin-top: 14rpx;
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.55;
  color: #333333;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.work-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.play-small,
.delete-small,
.feedback-small,
.teacher-small {
  flex: 1;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  font-size: var(--font-ui-23, 23rpx);
  font-weight: 800;
}

.play-small {
  color: #3478f6;
  background: #eef4ff;
}

.delete-small {
  color: #d84d4d;
  background: #fff0f0;
}

.primary-actions,
.secondary-actions {
  flex-wrap: wrap;
}

.secondary-actions {
  margin-top: 14rpx;
}

.public-btn,
.unpublic-btn {
  flex: 1;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  font-size: var(--font-ui-24, 24rpx);
  font-weight: 800;
}

.public-btn {
  color: #16c784;
  background: #eaf8f0;
}

.unpublic-btn {
  color: #d84d4d;
  background: #fff0f0;
}

.feedback-ai-btn {
  color: #ffffff;
  background: #5568d9;
}

.feedback-pending-btn {
  color: #8a8f99;
  background: #edf1f6;
}

.feedback-generating-btn {
  opacity: 0.75;
  color: #4f63e6;
  background: #eef2ff;
}

.feedback-done-btn {
  color: #5568d9;
  background: #eef1ff;
}

.feedback-blocked-btn {
  color: #8a6d1f;
  background: #fff7dc;
}

.feedback-error-btn {
  color: #d84d4d;
  background: #fff0f0;
}

.teacher-ready-btn {
  color: #17352d;
  background: #eaf8f0;
}

.teacher-pending-btn {
  color: #6f7885;
  background: #f2f4f7;
}

.teacher-done-btn {
  color: #17352d;
  background: #eaf8f0;
}

.status-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.state-pill {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: var(--font-ui-21, 21rpx);
  font-weight: 800;
}

.ai-wait-tag {
  color: #8a8f99;
  background: #edf1f6;
}

.ai-pending-tag {
  color: #8a8f99;
  background: #edf1f6;
}

.ai-generating-tip {
  display: block;
  margin: 12rpx 0 0;
  color: #5568d9;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.45;
}

.ai-done-tag {
  color: #5568d9;
  background: #eef1ff;
}

.ai-error-tag {
  color: #d84d4d;
  background: #fff0f0;
}

.ai-blocked-tag {
  color: #8a6d1f;
  background: #fff7dc;
}

.teacher-ready-tag {
  color: #07c160;
  background: #eaf8ef;
}

.teacher-pending-tag {
  color: #6f7885;
  background: #f2f4f7;
}

.teacher-done-tag {
  color: #07c160;
  background: #eaf8ef;
}

.audio-player {
  margin-top: 16rpx;
  padding: 16rpx 18rpx 10rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #edf1f6;
}

.audio-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7f8794;
  font-size: 22rpx;
  font-weight: 700;
}

.audio-slider {
  margin: 8rpx 0 0;
}

.ai-feedback-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(17, 24, 39, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

.ai-feedback-panel {
  width: 100%;
  max-height: 82vh;
  border-radius: 28rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 28rpx 70rpx rgba(15, 23, 42, 0.22);
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.ai-feedback-header {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eef0f4;
  box-sizing: border-box;
  flex-shrink: 0;
}

.ai-feedback-title {
  color: #111827;
  font-size: var(--font-reading-34, 34rpx);
  font-weight: 900;
}

.ai-feedback-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  color: #8a92a3;
  background: #f3f5f8;
  font-size: 36rpx;
  box-sizing: border-box;
}

.ai-feedback-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.ai-feedback-content {
  width: 100%;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ai-feedback-content > .ai-generated-notice {
  margin: 0 0 20rpx;
}

.ai-mode-notice {
  margin: 0 0 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.5;
}

.ai-mode-metadata {
  background: #eef4ff;
  color: #3478f6;
}

.ai-mode-transcript {
  background: #eef8f2;
  color: #07c160;
}

.ai-mode-no-speech {
  background: #fff7e6;
  color: #9a6400;
}

.ai-section {
  margin-bottom: 26rpx;
}

.ai-section-title {
  margin-bottom: 10rpx;
  color: #24315f;
  font-size: var(--font-ui-27, 27rpx);
  font-weight: 900;
}

.ai-section-text,
.ai-list-item {
  color: #3f4654;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.65;
  overflow-wrap: break-word;
  word-break: break-word;
}

.ai-list-item {
  margin-bottom: 8rpx;
}

.ai-dimension-item {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f7f9fc;
}

.ai-dimension-item:last-child {
  margin-bottom: 0;
}

.ai-dimension-row {
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-dimension-name {
  color: #24315f;
  font-size: var(--font-ui-26, 26rpx);
  font-weight: 800;
}

.ai-dimension-score {
  flex-shrink: 0;
  color: #5568d9;
  font-size: 25rpx;
  font-weight: 900;
}

.ai-caution {
  margin: 6rpx 0 0;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #fff7e6;
  color: #9a6400;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.55;
  overflow-wrap: break-word;
  word-break: break-word;
}

.ai-tone-tip {
  color: #5568d9;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.55;
  overflow-wrap: break-word;
  word-break: break-word;
}
