page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.version-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.hero-card {
  padding: 38rpx 32rpx;
  background: linear-gradient(135deg, #27364a 0%, #3a4a63 100%);
  color: #ffffff;
}

.hero-title {
  display: block;
  font-size: var(--font-ui-44, 44rpx);
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc {
  display: block;
  color: rgba(255, 255, 255, 0.78);
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.5;
}

.section-card {
  margin-top: 28rpx;
  padding: 8rpx 30rpx;
}

.font-size-section {
  padding-top: 30rpx;
  padding-bottom: 30rpx;
}

.font-size-heading-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.font-size-heading {
  min-width: 0;
  flex: 1;
}

.font-scale-value {
  flex-shrink: 0;
  min-width: 94rpx;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  color: #087a40;
  background: #eaf8f0;
  font-size: var(--font-ui-28, 28rpx);
  line-height: 1.2;
  font-weight: 900;
  text-align: center;
  box-sizing: border-box;
}

.font-slider-area {
  margin-top: 24rpx;
  padding: 0 4rpx;
}

.font-slider-visual {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 10rpx;
  color: #354052;
}

.font-slider-a {
  line-height: 1;
  font-weight: 900;
}

.font-slider-a-small {
  font-size: 26rpx;
}

.font-slider-a-large {
  font-size: 44rpx;
}

.font-scale-slider {
  margin: 4rpx 0 0;
  padding: 12rpx 0;
}

.font-slider-scale {
  position: relative;
  height: 34rpx;
  margin: -2rpx 8rpx 0;
  color: #8a8f99;
  font-size: 21rpx;
  line-height: 1.4;
}

.font-slider-min,
.font-slider-standard,
.font-slider-max {
  position: absolute;
  top: 0;
  white-space: nowrap;
}

.font-slider-min {
  left: 0;
}

.font-slider-standard {
  color: #5f6877;
  font-weight: 800;
  transform: translateX(-50%);
}

.font-slider-max {
  right: 0;
}

.font-size-preview {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f5f7fb;
}

.font-size-preview-label {
  display: block;
  margin-bottom: 10rpx;
  color: #8a8f99;
  font-size: var(--font-ui-22, 22rpx);
  line-height: 1.4;
}

.font-size-preview-copy {
  display: block;
  color: #20242c;
  font-size: var(--font-reading-30, 30rpx);
  line-height: 1.65;
}

.setting-item {
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
  box-sizing: border-box;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-copy {
  min-width: 0;
  flex: 1;
}

.setting-title {
  display: block;
  color: #111111;
  font-size: var(--font-ui-30, 30rpx);
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.danger-title {
  color: #d84d4d;
}

.setting-desc {
  display: block;
  color: #8a8f99;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.45;
}

.arrow {
  color: #a0a6b1;
  font-size: 48rpx;
  line-height: 1;
  margin-left: 20rpx;
}

.version-card {
  margin-top: 28rpx;
  padding: 30rpx;
}

.version-label {
  display: block;
  color: #111111;
  font-size: var(--font-ui-30, 30rpx);
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.version-text {
  display: block;
  color: #8a8f99;
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.5;
}
