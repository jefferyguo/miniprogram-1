page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.version-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.hero-card {
  padding: 38rpx 32rpx;
  background: linear-gradient(135deg, #27364a 0%, #3a4a63 100%);
  color: #ffffff;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc {
  display: block;
  color: rgba(255, 255, 255, 0.78);
  font-size: 27rpx;
  line-height: 1.5;
}

.section-card {
  margin-top: 28rpx;
  padding: 8rpx 30rpx;
}

.setting-item {
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f2f6;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-copy {
  min-width: 0;
  flex: 1;
}

.setting-title {
  display: block;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.danger-title {
  color: #d84d4d;
}

.setting-desc {
  display: block;
  color: #8a8f99;
  font-size: 24rpx;
  line-height: 1.45;
}

.arrow {
  color: #a0a6b1;
  font-size: 48rpx;
  line-height: 1;
  margin-left: 20rpx;
}

.version-card {
  margin-top: 28rpx;
  padding: 30rpx;
}

.version-label {
  display: block;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.version-text {
  display: block;
  color: #8a8f99;
  font-size: 26rpx;
  line-height: 1.5;
}
