page {
  background: #f6f7f9;
}

.page {
  padding: 32rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #07c160, #25d98a);
  color: #ffffff;
  margin-bottom: 28rpx;
}

.hello {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: var(--font-ui-26, 26rpx);
  opacity: 0.9;
}

.level-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.level-title {
  font-size: var(--font-ui-22, 22rpx);
  opacity: 0.9;
}

.level-value {
  font-size: 36rpx;
  font-weight: 700;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.card-title {
  display: block;
  font-size: var(--font-ui-32, 32rpx);
  font-weight: 700;
  color: #222222;
}

.card-desc {
  display: block;
  font-size: var(--font-reading-26, 26rpx);
  color: #777777;
  margin-top: 12rpx;
  line-height: 1.6;
}

.tag {
  font-size: 22rpx;
  color: #ff8a00;
  background: #fff3e0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.tag.green {
  color: #07c160;
  background: #e8f8ef;
}

.task-title {
  display: block;
  font-size: var(--font-ui-36, 36rpx);
  font-weight: 700;
  color: #111111;
  margin-bottom: 16rpx;
}

.task-desc {
  display: block;
  font-size: var(--font-reading-28, 28rpx);
  color: #555555;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.task-info {
  display: flex;
  flex-direction: column;
  font-size: var(--font-reading-24, 24rpx);
  color: #888888;
  line-height: 1.8;
  margin-bottom: 28rpx;
}

.primary-btn {
  background: #07c160;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: var(--font-ui-30, 30rpx);
  font-weight: 600;
}

.assessment-card,
.review-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.small-btn {
  width: 150rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: var(--font-ui-26, 26rpx);
  border-radius: 999rpx;
  background: #07c160;
  color: #ffffff;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.ability-row {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}

.ability-item {
  width: 30%;
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 24rpx 0;
  text-align: center;
}

.ability-score {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #07c160;
  margin-bottom: 8rpx;
}

.ability-label {
  font-size: var(--font-ui-24, 24rpx);
  color: #666666;
}

.progress-bg {
  width: 100%;
  height: 18rpx;
  background: #edf0f2;
  border-radius: 999rpx;
  margin-top: 24rpx;
  overflow: hidden;
}

.progress-bar {
  height: 18rpx;
  background: #07c160;
  border-radius: 999rpx;
}

.bottom-actions {
  display: flex;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

.outline-btn,
.buy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: var(--font-ui-28, 28rpx);
}

.outline-btn {
  background: #ffffff;
  color: #07c160;
  border: 2rpx solid #07c160;
  margin-right: 18rpx;
}

.buy-btn {
  background: #111111;
  color: #ffffff;
}
