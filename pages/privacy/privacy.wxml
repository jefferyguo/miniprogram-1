<page-meta page-style="{{fontSizePageStyle}}"></page-meta>
<view class="page">
  <view class="hero-card">
    <text class="hero-title">{{pageTitle}}</text>
    <text class="hero-desc">{{pageDesc}}</text>
  </view>

  <view wx:if="{{showVoiceAgreement}}" class="voice-agreement-entry" bindtap="openVoiceprintAgreement">
    <view class="voice-entry-copy">
      <text class="voice-entry-title">声纹授权协议</text>
      <text class="voice-entry-desc">查看声音信息的收集目的、处理方式和撤回方法</text>
    </view>
    <text class="voice-entry-arrow">›</text>
  </view>

  <view class="section-card" wx:for="{{sections}}" wx:key="title">
    <text class="section-title">{{item.title}}</text>
    <view class="privacy-item" wx:for="{{item.items}}" wx:for-item="line" wx:key="*this">
      <text class="dot"></text>
      <text class="privacy-text">{{line}}</text>
    </view>
  </view>
</view>
