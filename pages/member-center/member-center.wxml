<page-meta page-style="{{fontSizePageStyle}}"></page-meta>
<view class="page">
  <view class="hero-card">
    <text class="hero-eyebrow">{{accessLabel}}</text>
    <text class="hero-title">{{isMember ? accessLabel : '普通用户'}}</text>
    <text class="hero-desc">{{accessDesc}}</text>
    <text class="expire-text">当前身份：{{isMember ? accessLabel : '普通用户'}}</text>
    <text class="expire-text">当前手机号：{{phoneMask}}</text>
    <text class="expire-text">会员到期：{{membershipExpireText}}</text>
  </view>

  <view class="benefit-card">
    <text class="section-title">普通用户</text>
    <view class="benefit-item" wx:for="{{normalBenefits}}" wx:key="*this">
      <text class="benefit-dot"></text><text class="benefit-text">{{item}}</text>
    </view>
  </view>

  <view class="benefit-card">
    <text class="section-title">会员用户</text>
    <view class="benefit-item" wx:for="{{memberBenefits}}" wx:key="*this">
      <text class="benefit-dot"></text><text class="benefit-text">{{item}}</text>
    </view>
  </view>

  <view class="plan-card">
    <view class="plan-head">
      <view>
        <text class="plan-title">{{isMember ? '会员状态' : '开通会员'}}</text>
        <text class="plan-desc">{{isMember ? '已解锁全部进阶训练，每天可使用 5 次 AI 测评/反馈。' : '开通后可继续学习 Day 4+ 内容，并提升每日 AI 使用次数。'}}</text>
      </view>
    </view>

    <view class="payment-notice">请选择会员类型，通过小程序虚拟支付完成购买。支付确认成功后，系统会自动开通会员权益。</view>

    <view wx:if="{{hasPackages}}">
      <view class="package-item" wx:for="{{packages}}" wx:key="id">
        <text class="package-title">已有训练权限</text>
        <text class="package-desc">{{item.displayName}} · {{item.statusText}} · 到期：{{item.expireText}}</text>
      </view>
    </view>
    <view wx:else class="empty-text">暂无训练包权限</view>

    <view wx:if="{{productsLoading}}" class="payment-notice">正在读取会员商品…</view>
    <view wx:else class="product-list">
      <view class="product-card" wx:for="{{products}}" wx:key="productId">
        <view class="product-main">
          <view class="product-title-row">
            <text class="package-title">{{item.title}}</text>
            <text class="product-price">{{item.priceText}}<text class="product-unit">{{item.unitText}}</text></text>
          </view>
          <text class="package-desc">{{item.description}}</text>
          <text class="product-duration">有效期 {{item.durationDays}} 天</text>
        </view>
        <button
          class="product-buy-btn {{item.buttonDisabled ? 'product-buy-btn-disabled' : ''}}"
          data-product-id="{{item.productId}}"
          disabled="{{item.buttonDisabled || paymentBusy}}"
          bindtap="purchaseMembership"
        >{{item.buttonText}}</button>
      </view>
    </view>

    <view wx:if="{{!paymentConfigured}}" class="payment-notice payment-notice-warning">会员支付能力配置中，请稍后再试。</view>
    <view wx:if="{{paymentStatusText}}" class="payment-status">
      <text>{{paymentStatusText}}</text>
      <button class="status-refresh-btn" bindtap="refreshPaymentStatus">刷新会员状态</button>
    </view>
  </view>
  <login-gate id="login-gate" />
</view>
