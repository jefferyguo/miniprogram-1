page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card {
  border-radius: 34rpx;
  padding: 40rpx 34rpx;
  background: linear-gradient(135deg, #fff8ea 0%, #eef8f2 100%);
  border: 1rpx solid #f1e0bf;
  box-shadow: 0 16rpx 40rpx rgba(138, 90, 22, 0.10);
}

.hero-eyebrow {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #8a5a16;
  background: #fff4dc;
  font-size: var(--font-ui-23, 23rpx);
  font-weight: 900;
  margin-bottom: 18rpx;
}

.hero-title {
  display: block;
  color: #111827;
  font-size: var(--font-ui-46, 46rpx);
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc,
.expire-text {
  display: block;
  color: #6b7280;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.55;
}

.expire-text {
  margin-top: 14rpx;
  color: #8a5a16;
  font-weight: 800;
}

.benefit-card,
.plan-card,
.dev-card {
  margin-top: 26rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #edf1f6;
  box-shadow: 0 14rpx 36rpx rgba(31, 41, 55, 0.05);
  box-sizing: border-box;
}

.section-title {
  display: block;
  color: #111827;
  font-size: var(--font-ui-34, 34rpx);
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 22rpx;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.benefit-item:last-child {
  margin-bottom: 0;
}

.benefit-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d89b3d;
  margin: 16rpx 16rpx 0 0;
  flex-shrink: 0;
}

.benefit-text {
  flex: 1;
  min-width: 0;
  color: #4b5563;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.55;
}

.plan-head {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.plan-title {
  display: block;
  color: #111827;
  font-size: var(--font-ui-34, 34rpx);
  font-weight: 900;
  line-height: 1.3;
}

.plan-desc {
  display: block;
  margin-top: 8rpx;
  color: #8a93a3;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.4;
}

.plan-price {
  flex-shrink: 0;
  color: #8a5a16;
  font-size: 30rpx;
  font-weight: 900;
}

.primary-btn,
.secondary-btn,
.dev-btn,
.danger-btn {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  font-size: var(--font-ui-27, 27rpx);
  font-weight: 900;
}

.primary-btn {
  color: #ffffff;
  background: #d89b3d;
}

.disabled-primary {
  color: #8a5a16;
  background: #fff4dc;
}

.secondary-btn {
  color: #8a5a16;
  background: #fff4dc;
  margin-top: 16rpx;
}

.package-item {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  margin-bottom: 16rpx;
}

.package-title {
  display: block;
  color: #111827;
  font-size: var(--font-ui-28, 28rpx);
  line-height: 1.35;
  font-weight: 900;
}

.package-desc,
.empty-text {
  display: block;
  margin-top: 8rpx;
  color: #687280;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.5;
}

.product-list {
  margin-top: 24rpx;
}

.product-card {
  padding: 26rpx;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid #f0dfbe;
  background: linear-gradient(135deg, #fffdf8 0%, #fff7e8 100%);
}

.product-main {
  min-width: 0;
}

.product-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.product-price {
  color: #b87316;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 900;
  flex-shrink: 0;
}

.product-unit {
  margin-left: 4rpx;
  color: #9a7b4d;
  font-size: 22rpx;
  font-weight: 700;
}

.product-duration {
  display: block;
  margin-top: 10rpx;
  color: #9a7b4d;
  font-size: 22rpx;
  font-weight: 800;
}

.product-buy-btn {
  height: 70rpx;
  line-height: 70rpx;
  margin: 22rpx 0 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #d89b3d;
  font-size: var(--font-ui-25, 25rpx);
  font-weight: 900;
}

.product-buy-btn-disabled {
  color: #9a7b4d;
  background: #f5ead5;
}

.payment-notice,
.payment-status {
  padding: 22rpx 24rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
  color: #596579;
  background: #f6f8fb;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.5;
  text-align: center;
}

.payment-notice-warning {
  color: #9a651b;
  background: #fff5df;
  border: 1rpx solid #f3dfb6;
}

.status-refresh-btn {
  width: 240rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 16rpx auto 0;
  border-radius: 999rpx;
  color: #8a5a16;
  background: #fff4dc;
  font-size: var(--font-ui-22, 22rpx);
  font-weight: 900;
}

.empty-text {
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  text-align: center;
}

.dev-desc {
  display: block;
  color: #8a93a3;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.55;
  margin-bottom: 22rpx;
}

.dev-btn,
.danger-btn {
  width: 100%;
  margin-top: 16rpx;
}

.dev-btn {
  color: #16c784;
  background: #eaf8f0;
}

.danger-btn {
  color: #d84d4d;
  background: #fff0f0;
}
