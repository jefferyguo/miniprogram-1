page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 170rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card {
  border-radius: 34rpx;
  padding: 40rpx 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #27364a 0%, #3a4a63 100%);
  box-shadow: 0 16rpx 42rpx rgba(38, 50, 70, 0.16);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc {
  display: block;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.5;
}

.hero-badge {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #253246;
  background: rgba(255, 255, 255, 0.88);
  font-size: 23rpx;
  font-weight: 900;
}

.section {
  margin-top: 34rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  color: #111111;
  font-size: 33rpx;
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.no-margin {
  margin-bottom: 0;
}

.stat-grid,
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-card,
.quick-card,
.pending-card,
.empty-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(38, 50, 70, 0.06);
}

.stat-value {
  display: block;
  color: #1f6feb;
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 900;
}

.stat-card:nth-child(2) .stat-value,
.stat-card:nth-child(3) .stat-value {
  color: #07c160;
}

.stat-label {
  display: block;
  margin-top: 10rpx;
  color: #8a8f99;
  font-size: 24rpx;
  line-height: 1.35;
}

.quick-card {
  min-height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  box-sizing: border-box;
}

.quick-main {
  min-width: 0;
}

.quick-title {
  display: block;
  color: #111111;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.quick-desc {
  display: block;
  color: #7a8190;
  font-size: 23rpx;
  line-height: 1.45;
}

.quick-arrow {
  flex-shrink: 0;
  color: #a0a7b5;
  font-size: 44rpx;
  line-height: 1;
}

.card-hover {
  background: #f8fafc;
}

.section-link-btn {
  flex-shrink: 0;
  width: 150rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #1f6feb;
  background: #eef4ff;
  font-size: 24rpx;
  font-weight: 900;
}

.pending-card {
  margin-bottom: 20rpx;
}

.pending-student,
.pending-title {
  display: block;
  color: #111111;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.pending-line {
  display: block;
  color: #7a8190;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.review-btn {
  width: 180rpx;
  height: 66rpx;
  line-height: 66rpx;
  margin: 20rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #1f6feb;
  font-size: 25rpx;
  font-weight: 900;
}

.empty-card {
  color: #8a8f99;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.logout-text-btn {
  width: 220rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 34rpx auto 0;
  padding: 0;
  color: #d84d4d;
  background: transparent;
  font-size: 26rpx;
  font-weight: 900;
}

.teacher-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  background: #ffffff;
  border-top: 1rpx solid #eef0f4;
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 99;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -8rpx 28rpx rgba(38, 50, 70, 0.05);
}

.teacher-tab-item {
  flex: 1;
  text-align: center;
  color: #8a8f99;
  font-size: 22rpx;
  line-height: 1.25;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.teacher-tab-item.active {
  color: #1f6feb;
  font-weight: 700;
}

.teacher-tab-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 14rpx;
  background: #f2f5fa;
  font-size: 21rpx;
  font-weight: 900;
}

.teacher-tab-item.active .teacher-tab-icon {
  color: #ffffff;
  background: #1f6feb;
}
