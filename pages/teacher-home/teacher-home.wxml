<view class="page">
  <view class="hero-card">
    <view>
      <text class="hero-title">{{teacherName}}</text>
      <text class="hero-desc">老师工作台 · 管理作品与点评反馈</text>
    </view>
    <text class="hero-badge">教师端</text>
  </view>

  <view class="section">
    <text class="section-title">今日工作概览</text>
    <view class="stat-grid">
      <view class="stat-card" wx:for="{{stats}}" wx:key="label">
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">快捷操作</text>
    <view class="quick-grid">
      <view
        class="quick-card"
        wx:for="{{quickActions}}"
        wx:key="title"
        data-action="{{item.action}}"
        bindtap="handleQuickTap"
        hover-class="card-hover"
      >
        <view class="quick-main">
          <text class="quick-title">{{item.title}}</text>
          <text class="quick-desc">{{item.desc}}</text>
        </view>
        <text class="quick-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title no-margin">近期待点评</text>
      <button class="section-link-btn" bindtap="goPendingReview">查看全部</button>
    </view>

    <view wx:if="{{recentPendingWorks.length > 0}}">
      <view class="pending-card" wx:for="{{recentPendingWorks}}" wx:key="key">
        <text class="pending-student">学员：{{item.studentName || '同学'}}</text>
        <text class="pending-title">任务：{{item.displayTitle}} / {{item.displaySubtitle}}</text>
        <text class="pending-line">时长：{{item.displayDuration}} · {{item.displayCreatedAt}}</text>
        <button class="review-btn" bindtap="goPendingReview">去点评</button>
      </view>
    </view>

    <view class="empty-card" wx:else>
      <text>暂无待点评作品</text>
    </view>
  </view>

  <button class="logout-text-btn" bindtap="logoutTeacher">退出老师端</button>

  <view class="teacher-tabbar">
    <view class="teacher-tab-item active" data-url="/pages/teacher-home/teacher-home" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">台</text>
      <text>工作台</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-review/teacher-review?type=all" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">作</text>
      <text>作品</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-favorites/teacher-favorites" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">藏</text>
      <text>收藏</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-home/teacher-home" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">师</text>
      <text>我的</text>
    </view>
  </view>
</view>
