<view class="page">
  <view class="hero-card">
    <text class="hero-title">我的作品</text>
    <text class="hero-desc">查看你的录音、录像和提交状态</text>
  </view>

  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-value">{{totalCount}}</text>
      <text class="stat-label">全部作品</text>
    </view>
    <view class="stat-card">
      <text class="stat-value green-value">{{submittedCount}}</text>
      <text class="stat-label">已提交</text>
    </view>
    <view class="stat-card">
      <text class="stat-value gray-value">{{draftCount}}</text>
      <text class="stat-label">未提交</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">作品列表</text>

    <view wx:if="{{works.length > 0}}">
      <view class="work-card" wx:for="{{works}}" wx:key="key">
        <view class="work-top">
          <text class="work-type">{{item.typeText}}</text>
          <text class="status-tag {{item.statusClass}}" data-key="{{item.key}}" bindtap="showWorkStatus">{{item.statusText}}</text>
        </view>

        <text class="work-source">来源：{{item.sourceText}}</text>
        <text class="work-title">{{item.titleText}}</text>
        <text class="work-subtitle">{{item.subtitleText}}</text>

        <view class="work-meta">
          <text>时长：{{item.durationText}}</text>
          <text>时间：{{item.createdAtText}}</text>
        </view>

        <text wx:if="{{item.aiTip}}" class="ai-tip">{{item.aiTip}}</text>

        <view class="work-actions">
          <button class="play-btn" data-key="{{item.key}}" bindtap="playWork">{{item.actionText}}</button>
          <button
            wx:if="{{item.submitted}}"
            class="feedback-btn {{item.feedbackActionClass}}"
            data-key="{{item.key}}"
            disabled="{{item.feedbackActionDisabled}}"
            bindtap="handleFeedbackAction"
          >{{item.feedbackActionText}}</button>
          <button
            wx:if="{{item.hasTeacherFeedback}}"
            class="teacher-feedback-btn"
            data-key="{{item.key}}"
            bindtap="showTeacherFeedback"
          >查看老师点评</button>
          <button wx:if="{{!item.submitted}}" class="status-btn" data-key="{{item.key}}" bindtap="showWorkStatus">查看状态</button>
        </view>
      </view>
    </view>

    <view class="empty-card" wx:else>
      <text class="empty-title">暂无作品，先完成一次训练吧。</text>
      <button class="empty-btn" bindtap="switchToTraining">去训练</button>
    </view>
  </view>
</view>
