page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card {
  border-radius: 36rpx;
  padding: 40rpx 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #07c160, #3478f6);
  box-shadow: 0 16rpx 42rpx rgba(7, 193, 96, 0.20);
}

.hero-title {
  display: block;
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc {
  display: block;
  font-size: 27rpx;
  line-height: 1.5;
  opacity: 0.9;
}

.stats-row {
  margin-top: 24rpx;
  display: flex;
  gap: 18rpx;
}

.stat-card {
  flex: 1;
  min-width: 0;
  border-radius: 28rpx;
  padding: 28rpx 10rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.stat-value {
  display: block;
  color: #3478f6;
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 900;
}

.green-value {
  color: #07c160;
}

.gray-value {
  color: #8a8f99;
}

.stat-label {
  display: block;
  margin-top: 10rpx;
  color: #8a8f99;
  font-size: 23rpx;
}

.section {
  margin-top: 34rpx;
}

.section-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.work-card,
.empty-card {
  border-radius: 28rpx;
  padding: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.work-card {
  margin-bottom: 24rpx;
}

.work-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.work-type {
  color: #222222;
  font-size: 30rpx;
  font-weight: 900;
}

.status-tag {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.synced-tag {
  color: #07c160;
  background: #e8f8ef;
}

.saved-tag {
  color: #8a8f99;
  background: #f2f4f7;
}

.work-source,
.work-subtitle {
  display: block;
  color: #8a8f99;
  font-size: 25rpx;
  line-height: 1.55;
}

.public-status {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #16c784;
  background: #eaf8f0;
  font-size: 22rpx;
  font-weight: 900;
}

.work-title {
  display: block;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 900;
  margin: 8rpx 0;
}

.work-meta {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #9aa1aa;
  font-size: 24rpx;
}

.ai-tip {
  display: block;
  margin-top: 16rpx;
  color: #8a8f99;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.state-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.work-actions {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.secondary-actions {
  margin-top: 14rpx;
}

.play-btn,
.feedback-btn,
.teacher-feedback-btn,
.share-btn,
.public-btn,
.unpublic-btn,
.delete-btn,
.empty-btn {
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.play-btn,
.feedback-btn,
.teacher-feedback-btn,
.share-btn,
.public-btn,
.unpublic-btn,
.delete-btn {
  flex: 1;
  min-width: 0;
}

.play-btn {
  color: #3478f6;
  background: #eef4ff;
}

.share-btn {
  color: #3458c8;
  background: #f1f5ff;
}

.teacher-feedback-btn {
  color: #17352d;
  background: #eaf8f0;
}

.teacher-ready-btn {
  color: #17352d;
  background: #eaf8f0;
}

.teacher-pending-btn {
  color: #6f7885;
  background: #f2f4f7;
}

.teacher-done-btn {
  color: #17352d;
  background: #eaf8f0;
}

.public-btn {
  color: #16c784;
  background: #eaf8f0;
}

.unpublic-btn {
  color: #d84d4d;
  background: #fff0f0;
}

.delete-btn {
  color: #d84d4d;
  background: #fff0f0;
}

.feedback-ai-btn {
  color: #ffffff;
  background: #5568d9;
}

.feedback-pending-btn {
  color: #8a8f99;
  background: #edf1f6;
}

.feedback-generating-btn {
  opacity: 0.75;
  color: #4f63e6;
  background: #eef2ff;
}

.feedback-done-btn {
  color: #5568d9;
  background: #eef1ff;
}

.feedback-blocked-btn {
  color: #8a6d1f;
  background: #fff7dc;
}

.feedback-error-btn {
  color: #d84d4d;
  background: #fff0f0;
}

.ai-wait-tag,
.ai-pending-tag {
  color: #8a8f99;
  background: #edf1f6;
}

.ai-done-tag {
  color: #5568d9;
  background: #eef1ff;
}

.ai-error-tag {
  color: #d84d4d;
  background: #fff0f0;
}

.ai-blocked-tag {
  color: #8a6d1f;
  background: #fff7dc;
}

.teacher-ready-tag {
  color: #07c160;
  background: #eaf8ef;
}

.teacher-pending-tag {
  color: #6f7885;
  background: #f2f4f7;
}

.teacher-done-tag {
  color: #07c160;
  background: #eaf8ef;
}

.audio-player {
  margin-top: 16rpx;
  padding: 16rpx 18rpx 10rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #edf1f6;
}

.audio-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7f8794;
  font-size: 22rpx;
  font-weight: 700;
}

.audio-slider {
  margin: 8rpx 0 0;
}

.empty-card {
  text-align: center;
}

.empty-title {
  display: block;
  color: #8a8f99;
  font-size: 27rpx;
  line-height: 1.55;
  margin-bottom: 26rpx;
}

.empty-btn {
  width: 220rpx;
  color: #ffffff;
  background: #07c160;
}

.ai-feedback-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(17, 24, 39, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

.ai-feedback-panel {
  width: 100%;
  max-height: 82vh;
  border-radius: 28rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 28rpx 70rpx rgba(15, 23, 42, 0.22);
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.ai-feedback-header {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eef0f4;
  box-sizing: border-box;
  flex-shrink: 0;
}

.ai-feedback-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
}

.ai-feedback-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  color: #8a92a3;
  background: #f3f5f8;
  font-size: 36rpx;
  box-sizing: border-box;
}

.ai-feedback-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.ai-feedback-content {
  width: 100%;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ai-feedback-content > .ai-generated-notice {
  margin: 0 0 20rpx;
}

.ai-mode-notice {
  margin: 0 0 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.ai-mode-metadata {
  background: #eef4ff;
  color: #3478f6;
}

.ai-mode-transcript {
  background: #eef8f2;
  color: #07c160;
}

.ai-mode-no-speech {
  background: #fff7e6;
  color: #9a6400;
}

.ai-section {
  margin-bottom: 26rpx;
}

.ai-section-title {
  margin-bottom: 10rpx;
  color: #24315f;
  font-size: 27rpx;
  font-weight: 900;
}

.ai-section-text,
.ai-list-item {
  color: #3f4654;
  font-size: 27rpx;
  line-height: 1.65;
  overflow-wrap: break-word;
  word-break: break-word;
}

.ai-list-item {
  margin-bottom: 8rpx;
}

.ai-dimension-item {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f7f9fc;
}

.ai-dimension-item:last-child {
  margin-bottom: 0;
}

.ai-dimension-row {
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-dimension-name {
  color: #24315f;
  font-size: 26rpx;
  font-weight: 800;
}

.ai-dimension-score {
  flex-shrink: 0;
  color: #5568d9;
  font-size: 25rpx;
  font-weight: 900;
}

.ai-caution {
  margin: 6rpx 0 0;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #fff7e6;
  color: #9a6400;
  font-size: 25rpx;
  line-height: 1.55;
  overflow-wrap: break-word;
  word-break: break-word;
}

.ai-tone-tip {
  color: #5568d9;
  font-size: 25rpx;
  line-height: 1.55;
  overflow-wrap: break-word;
  word-break: break-word;
}
