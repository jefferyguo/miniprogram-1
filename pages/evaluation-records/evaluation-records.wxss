page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card,
.detail-hero {
  border: 1rpx solid #dde4ff;
  border-radius: 36rpx;
  padding: 40rpx 34rpx;
  background: linear-gradient(135deg, #f4f6ff 0%, #f7f2ff 100%);
  box-shadow: 0 16rpx 40rpx rgba(85, 104, 217, 0.08);
}

.hero-title,
.detail-title {
  display: block;
  color: #24315f;
  font-size: var(--font-ui-46, 46rpx);
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc,
.detail-desc,
.empty-desc,
.analysis-content,
.recording-line {
  display: block;
  color: #7a8192;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.55;
}

.stats-card,
.record-card,
.empty-card,
.score-card,
.analysis-card,
.recommend-card,
.recording-card {
  margin-top: 28rpx;
  border-radius: 30rpx;
  padding: 30rpx;
  background: #ffffff;
  border: 1rpx solid #eef1ff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.stats-card {
  display: grid;
  grid-template-columns: 1fr 1.3fr 1.1fr;
  gap: 16rpx;
}

.stat-item {
  min-width: 0;
  border-radius: 24rpx;
  padding: 20rpx 16rpx;
  background: #f4f6ff;
  box-sizing: border-box;
}

.stat-value {
  display: block;
  color: #5568d9;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.small-value {
  color: #24315f;
  font-size: 24rpx;
  line-height: 1.35;
}

.stat-label {
  display: block;
  color: #7a8192;
  font-size: var(--font-ui-22, 22rpx);
  line-height: 1.35;
}

.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.profile-tag,
.detail-badge {
  display: inline-block;
  padding: 9rpx 18rpx;
  border: 1rpx solid #dde4ff;
  border-radius: 999rpx;
  color: #5568d9;
  background: #f4f6ff;
  font-size: 23rpx;
  font-weight: 900;
}

.record-time,
.detail-time {
  color: #7a8192;
  font-size: var(--font-reading-23, 23rpx);
  line-height: 1.35;
}

.detail-time {
  display: block;
  margin-top: 18rpx;
}

.record-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.record-field {
  border-radius: 22rpx;
  padding: 18rpx;
  background: #fbfcff;
  box-sizing: border-box;
}

.field-label {
  display: block;
  color: #7a8192;
  font-size: var(--font-ui-22, 22rpx);
  line-height: 1.35;
  margin-bottom: 8rpx;
}

.field-value {
  display: block;
  color: #24315f;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.35;
  font-weight: 900;
}

.record-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.view-btn,
.delete-btn,
.back-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  font-size: var(--font-ui-26, 26rpx);
  font-weight: 900;
}

.view-btn,
.back-btn {
  color: #ffffff;
  background: #5568d9;
}

.delete-btn {
  color: #ff4d4f;
  background: #fff0f0;
}

.empty-card {
  text-align: center;
  padding: 44rpx 34rpx;
}

.empty-title {
  display: block;
  color: #24315f;
  font-size: var(--font-reading-34, 34rpx);
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.empty-btn {
  width: 220rpx;
  margin: 28rpx auto 0;
}

.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  color: #111111;
  font-size: var(--font-ui-34, 34rpx);
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.no-margin {
  margin-bottom: 0;
}

.score-card {
  margin-top: 16rpx;
  padding: 26rpx;
}

.score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.score-name {
  color: #24315f;
  font-size: 28rpx;
  font-weight: 900;
}

.score-value {
  color: #5568d9;
  font-size: 30rpx;
  font-weight: 900;
}

.score-track {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #eef1ff;
}

.score-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5568d9, #7c6ee6);
}

.analysis-card {
  margin-top: 16rpx;
  box-shadow: none;
}

.analysis-title {
  display: block;
  color: #24315f;
  font-size: var(--font-reading-29, 29rpx);
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.ai-report-card {
  margin-top: 28rpx;
  border-radius: 30rpx;
  padding: 30rpx;
  background: #ffffff;
  border: 1rpx solid #dde4ff;
  box-shadow: 0 12rpx 32rpx rgba(85, 104, 217, 0.06);
  box-sizing: border-box;
}

.ai-report-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #7a8192;
  background: #f2f4f7;
  font-size: 22rpx;
  font-weight: 800;
}

.fallback-tip,
.report-content,
.report-list-item {
  display: block;
  color: #7a8192;
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.6;
}

.fallback-tip {
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f4f6ff;
  color: #5568d9;
  font-weight: 800;
}

.ai-source-text {
  display: block;
  color: #9aa1aa;
  font-size: var(--font-reading-22, 22rpx);
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.report-section {
  margin-top: 24rpx;
}

.report-title {
  display: block;
  color: #24315f;
  font-size: var(--font-ui-28, 28rpx);
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.report-list-item {
  padding-left: 24rpx;
  margin-top: 8rpx;
}

.report-module {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  border-radius: 22rpx;
  padding: 20rpx;
  background: #f4f6ff;
}

.report-module-label {
  color: #7a8192;
  font-size: var(--font-ui-24, 24rpx);
  font-weight: 800;
}

.report-module-value {
  color: #5568d9;
  font-size: var(--font-reading-27, 27rpx);
  font-weight: 900;
}

.report-encouragement {
  display: block;
  margin-top: 22rpx;
  color: #24315f;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.5;
  font-weight: 900;
}

.recommend-card {
  border-color: #dde4ff;
  background: #f4f6ff;
}

.recommend-label {
  display: block;
  color: #5568d9;
  font-size: var(--font-ui-24, 24rpx);
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.recommend-title {
  display: block;
  color: #24315f;
  font-size: var(--font-ui-34, 34rpx);
  line-height: 1.4;
  font-weight: 900;
}

.recording-card .section-title {
  margin-bottom: 14rpx;
}

.back-btn {
  margin-top: 30rpx;
}
