<view class="page">
  <view class="header">
    <text class="title">{{homeCopy.welcomeText}}</text>
    <text class="subtitle">{{homeCopy.trainingGuide}}</text>
  </view>

  <view class="evaluation-card">
    <view class="evaluation-head">
      <view class="evaluation-copy">
        <text class="evaluation-title">表达力测评</text>
        <text class="evaluation-subtitle">5–7 分钟了解你的表达状态</text>
      </view>
      <view class="evaluation-mark">测</view>
    </view>

    <text class="evaluation-desc">{{homeCopy.coursePreview}}</text>

    <view class="evaluation-tags">
      <text class="evaluation-tag">EEC表达力模型</text>
      <text class="evaluation-tag">40道结构化试题</text>
      <text class="evaluation-tag">可选录音题</text>
    </view>

    <button class="evaluation-btn" bindtap="openEvaluation">开始测评</button>
  </view>

  <view class="module-grid">
    <view
      class="module-card {{item.className}}"
      wx:for="{{modules}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openModule"
    >
      <view class="module-icon-wrap">
        <view wx:if="{{item.id === 'reading'}}" class="line-icon book-icon">
          <view class="book-page book-left"></view>
          <view class="book-page book-right"></view>
          <view class="book-spine"></view>
        </view>
        <view wx:elif="{{item.id === 'retell'}}" class="line-icon loop-icon">
          <view class="loop-arc loop-top"></view>
          <view class="loop-arc loop-bottom"></view>
          <view class="loop-arrow loop-arrow-top"></view>
          <view class="loop-arrow loop-arrow-bottom"></view>
        </view>
        <view wx:elif="{{item.id === 'topic'}}" class="line-icon bubble-icon">
          <view class="bubble-box"></view>
          <view class="bubble-tail"></view>
        </view>
        <view wx:elif="{{item.id === 'mandarin'}}" class="line-icon mic-icon">
          <view class="mic-head"></view>
          <view class="mic-stem"></view>
          <view class="mic-base"></view>
        </view>
        <view wx:elif="{{item.id === 'speech'}}" class="line-icon podium-icon">
          <view class="podium-board"></view>
          <view class="podium-stand"></view>
          <view class="podium-base"></view>
        </view>
        <view wx:else class="line-icon document-icon">
          <view class="document-page"></view>
          <view class="document-line document-line-one"></view>
          <view class="document-line document-line-two"></view>
        </view>
      </view>
      <text class="module-title">{{item.title}}</text>
      <text class="module-desc">{{item.desc}}</text>
    </view>
  </view>

  <view class="extra-card">
    <text class="section-title">每日加餐训练</text>
    <text class="section-subtitle">不想按课程练时，可以随机加餐练一次</text>

    <view class="extra-list">
      <view
        class="extra-item"
        wx:for="{{extraTrainings}}"
        wx:key="title"
        data-id="{{item.id}}"
        bindtap="openExtraTraining"
      >
        <view class="extra-icon {{item.iconClass}}">
          <view wx:if="{{item.id === 'dailyQuote'}}" class="extra-line-icon quote-icon">
            <view class="quote-mark"></view>
            <view class="quote-mark"></view>
          </view>
          <view wx:elif="{{item.id === 'randomTopic'}}" class="extra-line-icon dice-icon">
            <view class="dice-dot dot-one"></view>
            <view class="dice-dot dot-two"></view>
            <view class="dice-dot dot-three"></view>
          </view>
          <view wx:else class="extra-line-icon wave-icon">
            <view class="wave-line wave-one"></view>
            <view class="wave-line wave-two"></view>
            <view class="wave-line wave-three"></view>
          </view>
        </view>
        <view class="extra-content">
          <text class="extra-title">{{item.title}}</text>
          <text class="extra-desc">{{item.desc}}</text>
        </view>
        <text class="extra-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="record-card recent-card">
    <view class="record-head">
      <view>
        <text class="record-heading">最近训练</text>
        <text class="record-subtitle">记录会在提交作品后自动更新</text>
      </view>
      <button class="continue-btn" bindtap="continueTraining">{{hasRecentRecord ? '继续训练' : '开始训练'}}</button>
    </view>

    <view wx:if="{{hasRecentRecord}}" class="recent-body">
      <view class="recent-main">
        <text class="record-title">{{recentRecord.displayModuleTitle}} · Day {{recentRecord.day}}</text>
        <text class="record-desc">{{recentRecord.taskTitle}}</text>
        <text class="record-time">{{recentRecord.displayTime}}</text>
      </view>
      <text class="record-status">已完成</text>
    </view>

    <view class="recent-empty" wx:else>
      <text class="empty-title">暂无训练记录</text>
      <text class="empty">先从朗读训练 Day 1 开始，完成一次录音或录像后会出现在这里。</text>
    </view>
  </view>

  <view class="weekly-schedule-group">
    <view
      class="weekly-strip weekly-strip-{{item.type}}"
      wx:for="{{weeklyScheduleEntries}}"
      wx:key="type"
      data-type="{{item.type}}"
      bindtap="goWeeklySchedule"
    >
      <view class="weekly-strip-copy">
        <text class="weekly-strip-left">{{item.label}}</text>
        <text class="weekly-strip-text {{item.hasSchedule ? '' : 'weekly-strip-empty'}}">{{item.summary}}</text>
      </view>
      <view class="weekly-strip-action">
        <text>查看</text>
        <text class="weekly-strip-arrow">›</text>
      </view>
    </view>
  </view>
</view>
