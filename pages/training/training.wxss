page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  line-height: 1.15;
  font-weight: 900;
  color: #111111;
  margin-bottom: 14rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: #666666;
}

.evaluation-card {
  margin-bottom: 32rpx;
  border: 1rpx solid #dde4ff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(85, 104, 217, 0.08);
}

.evaluation-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 18rpx;
}

.evaluation-copy {
  min-width: 0;
}

.evaluation-title {
  display: block;
  color: #24315f;
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.evaluation-subtitle {
  display: block;
  color: #5568d9;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 800;
}

.evaluation-mark {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 50%;
  text-align: center;
  color: #5568d9;
  background: #f4f6ff;
  font-size: 30rpx;
  font-weight: 900;
}

.evaluation-desc {
  display: block;
  color: #7a8192;
  font-size: 26rpx;
  line-height: 1.6;
}

.evaluation-tags {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.evaluation-tag {
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  color: #5568d9;
  background: #f4f6ff;
  font-size: 23rpx;
  font-weight: 800;
}

.evaluation-btn {
  height: 78rpx;
  line-height: 78rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #5568d9;
  font-size: 27rpx;
  font-weight: 900;
}

.module-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
}

.module-card {
  width: calc((100% - 22rpx) / 2);
  min-height: 260rpx;
  border-radius: 34rpx;
  padding: 30rpx 28rpx;
  box-sizing: border-box;
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(40, 60, 80, 0.08);
}

.module-reading {
  background: linear-gradient(135deg, #4FB99F 0%, #6BC7B2 100%);
}

.module-retell {
  background: linear-gradient(135deg, #6D7FD6 0%, #8A80E8 100%);
}

.module-topic {
  background: linear-gradient(135deg, #E98D7A 0%, #F2A28E 100%);
}

.module-mandarin {
  background: linear-gradient(135deg, #5C9FD6 0%, #78A7E3 100%);
}

.module-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  margin-bottom: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.12);
}

.line-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
}

.book-page {
  position: absolute;
  top: 7rpx;
  width: 15rpx;
  height: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
}

.book-left {
  left: 3rpx;
  border-radius: 6rpx 2rpx 2rpx 6rpx;
}

.book-right {
  right: 3rpx;
  border-radius: 2rpx 6rpx 6rpx 2rpx;
}

.book-spine {
  position: absolute;
  left: 18rpx;
  top: 8rpx;
  width: 2rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
}

.loop-arc {
  position: absolute;
  width: 26rpx;
  height: 16rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
}

.loop-top {
  top: 5rpx;
  left: 4rpx;
  border-bottom: none;
  border-radius: 18rpx 18rpx 0 0;
}

.loop-bottom {
  bottom: 5rpx;
  right: 4rpx;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
}

.loop-arrow {
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
}

.loop-arrow-top {
  top: 3rpx;
  right: 4rpx;
  border-width: 6rpx 0 6rpx 8rpx;
  border-color: transparent transparent transparent rgba(255, 255, 255, 0.92);
}

.loop-arrow-bottom {
  bottom: 3rpx;
  left: 4rpx;
  border-width: 6rpx 8rpx 6rpx 0;
  border-color: transparent rgba(255, 255, 255, 0.92) transparent transparent;
}

.bubble-box {
  position: absolute;
  left: 4rpx;
  top: 7rpx;
  width: 30rpx;
  height: 22rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 10rpx;
  box-sizing: border-box;
}

.bubble-tail {
  position: absolute;
  left: 12rpx;
  bottom: 5rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid rgba(255, 255, 255, 0.92);
  border-bottom: 3rpx solid rgba(255, 255, 255, 0.92);
  transform: rotate(-28deg);
  box-sizing: border-box;
}

.mic-head {
  position: absolute;
  left: 11rpx;
  top: 3rpx;
  width: 16rpx;
  height: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.mic-stem {
  position: absolute;
  left: 18rpx;
  top: 27rpx;
  width: 3rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
}

.mic-base {
  position: absolute;
  left: 10rpx;
  bottom: 0;
  width: 18rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
}

.module-title {
  display: block;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 14rpx;
}

.module-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  opacity: 0.92;
}

.record-card {
  margin-top: 34rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.extra-card {
  margin-top: 34rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  background: #fff8e8;
  box-shadow: 0 12rpx 32rpx rgba(255, 176, 32, 0.08);
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #222222;
  margin-bottom: 10rpx;
}

.section-subtitle {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  color: #8a8f99;
  margin-bottom: 24rpx;
}

.extra-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.extra-item {
  min-height: 116rpx;
  border-radius: 26rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(255, 176, 32, 0.12);
}

.extra-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.extra-line-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.extra-icon-quote {
  background: #fff7e8;
  color: #f5a623;
}

.extra-icon-topic {
  background: #eef4ff;
  color: #4f7cff;
}

.extra-icon-twister {
  background: #fff0ea;
  color: #ff6b57;
}

.quote-icon {
  display: flex;
  gap: 7rpx;
  align-items: flex-start;
  justify-content: center;
}

.quote-mark {
  width: 9rpx;
  height: 18rpx;
  border-left: 4rpx solid #f5a623;
  border-bottom: 4rpx solid #f5a623;
  border-radius: 2rpx 0 0 8rpx;
  transform: skew(-8deg);
}

.dice-icon {
  border: 3rpx solid #4f7cff;
  border-radius: 9rpx;
  box-sizing: border-box;
}

.dice-dot {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #4f7cff;
}

.dot-one {
  left: 8rpx;
  top: 8rpx;
}

.dot-two {
  left: 14rpx;
  top: 14rpx;
}

.dot-three {
  right: 8rpx;
  bottom: 8rpx;
}

.wave-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.wave-line {
  width: 4rpx;
  border-radius: 999rpx;
  background: #ff6b57;
}

.wave-one {
  height: 16rpx;
  opacity: 0.72;
}

.wave-two {
  height: 28rpx;
}

.wave-three {
  height: 20rpx;
  opacity: 0.82;
}

.extra-content {
  min-width: 0;
  flex: 1;
}

.extra-title {
  display: block;
  font-size: 30rpx;
  color: #222222;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.extra-desc {
  display: block;
  font-size: 25rpx;
  line-height: 1.45;
  color: #8a8f99;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.record-heading {
  font-size: 34rpx;
  font-weight: 900;
  color: #111111;
}

.continue-btn {
  width: 176rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  background: #07c160;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.record-title {
  display: block;
  font-size: 30rpx;
  color: #111111;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.record-desc,
.empty {
  display: block;
  font-size: 26rpx;
  color: #7f8794;
  line-height: 1.55;
}
