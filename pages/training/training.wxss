page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

button::after {
  border: none;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: var(--font-ui-56, 56rpx);
  line-height: 1.15;
  font-weight: 900;
  color: #111111;
  margin-bottom: 14rpx;
}

.subtitle {
  display: block;
  font-size: var(--font-ui-28, 28rpx);
  line-height: 1.5;
  color: #666666;
}

.evaluation-card {
  margin-bottom: 32rpx;
  border: 1rpx solid #dde4ff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(85, 104, 217, 0.08);
}

.evaluation-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 18rpx;
}

.evaluation-copy {
  min-width: 0;
}

.evaluation-title {
  display: block;
  color: #24315f;
  font-size: var(--font-ui-36, 36rpx);
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.evaluation-subtitle {
  display: block;
  color: #5568d9;
  font-size: var(--font-ui-26, 26rpx);
  line-height: 1.45;
  font-weight: 800;
}

.evaluation-mark {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 50%;
  text-align: center;
  color: #5568d9;
  background: #f4f6ff;
  font-size: 30rpx;
  font-weight: 900;
}

.evaluation-desc {
  display: block;
  color: #7a8192;
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.6;
}

.evaluation-tags {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 10rpx;
}

.evaluation-tag {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  color: #5568d9;
  background: #f4f6ff;
  font-size: 22rpx;
  font-weight: 800;
}

.evaluation-btn {
  height: 78rpx;
  line-height: 78rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #5568d9;
  font-size: var(--font-ui-27, 27rpx);
  font-weight: 900;
}

.module-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
}

.module-card {
  width: calc((100% - 22rpx) / 2);
  min-height: 252rpx;
  border-radius: 30rpx;
  padding: 28rpx 26rpx;
  box-sizing: border-box;
  color: #20242c;
  background: #ffffff;
  border: 1rpx solid #e8edf3;
  box-shadow: 0 14rpx 30rpx rgba(25, 38, 64, 0.06);
}

.module-reading {
  border-left: 8rpx solid #44b79c;
}

.module-retell {
  border-left: 8rpx solid #687bd0;
}

.module-topic {
  border-left: 8rpx solid #e28b78;
}

.module-mandarin {
  border-left: 8rpx solid #579bd0;
}

.module-speech {
  border-left: 8rpx solid #8b6dd8;
}

.module-leader {
  border-left: 8rpx solid #c58b4c;
}

.module-icon-wrap {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  background: #f2f7f5;
  color: #44b79c;
  display: flex;
  align-items: center;
  justify-content: center;
}

.module-retell .module-icon-wrap {
  background: #f2f4ff;
  color: #687bd0;
}

.module-topic .module-icon-wrap {
  background: #fff4f0;
  color: #e28b78;
}

.module-mandarin .module-icon-wrap {
  background: #eff7ff;
  color: #579bd0;
}

.module-speech .module-icon-wrap {
  background: #f4f1ff;
  color: #8b6dd8;
}

.module-leader .module-icon-wrap {
  background: #fff5e8;
  color: #c58b4c;
}

.line-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
}

.book-page {
  position: absolute;
  top: 7rpx;
  width: 15rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
}

.book-left {
  left: 3rpx;
  border-radius: 6rpx 2rpx 2rpx 6rpx;
}

.book-right {
  right: 3rpx;
  border-radius: 2rpx 6rpx 6rpx 2rpx;
}

.book-spine {
  position: absolute;
  left: 18rpx;
  top: 8rpx;
  width: 2rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.loop-arc {
  position: absolute;
  width: 26rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
}

.loop-top {
  top: 5rpx;
  left: 4rpx;
  border-bottom: none;
  border-radius: 18rpx 18rpx 0 0;
}

.loop-bottom {
  bottom: 5rpx;
  right: 4rpx;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
}

.loop-arrow {
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
}

.loop-arrow-top {
  top: 3rpx;
  right: 4rpx;
  border-width: 6rpx 0 6rpx 8rpx;
  border-color: transparent transparent transparent currentColor;
}

.loop-arrow-bottom {
  bottom: 3rpx;
  left: 4rpx;
  border-width: 6rpx 8rpx 6rpx 0;
  border-color: transparent currentColor transparent transparent;
}

.bubble-box {
  position: absolute;
  left: 4rpx;
  top: 7rpx;
  width: 30rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.bubble-tail {
  position: absolute;
  left: 12rpx;
  bottom: 5rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-28deg);
  box-sizing: border-box;
}

.mic-head {
  position: absolute;
  left: 11rpx;
  top: 3rpx;
  width: 16rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.mic-stem {
  position: absolute;
  left: 18rpx;
  top: 27rpx;
  width: 3rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.mic-base {
  position: absolute;
  left: 10rpx;
  bottom: 0;
  width: 18rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.podium-board {
  position: absolute;
  left: 5rpx;
  top: 5rpx;
  width: 28rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.podium-stand {
  position: absolute;
  left: 18rpx;
  top: 21rpx;
  width: 3rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.podium-base {
  position: absolute;
  left: 8rpx;
  bottom: 2rpx;
  width: 22rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.document-page {
  position: absolute;
  left: 8rpx;
  top: 3rpx;
  width: 23rpx;
  height: 31rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.document-line {
  position: absolute;
  left: 13rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.document-line-one {
  top: 14rpx;
  width: 13rpx;
}

.document-line-two {
  top: 23rpx;
  width: 10rpx;
}

.module-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.module-title {
  display: block;
  font-size: var(--font-ui-32, 32rpx);
  line-height: 1.35;
  font-weight: 900;
  color: #20242c;
  margin-bottom: 14rpx;
}

.module-title-row .module-title {
  flex: 1;
  min-width: 0;
}

.soon-tag {
  flex-shrink: 0;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  color: #7a5dbb;
  background: #f4f1ff;
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 800;
}

.module-leader .soon-tag {
  color: #9a6a32;
  background: #fff5e8;
}

.module-desc {
  display: block;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.5;
  color: #747b88;
}

.record-card {
  margin-top: 34rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.recent-card {
  border: 1rpx solid #edf1f6;
}

.extra-card {
  margin-top: 34rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  background: #fff8e8;
  box-shadow: 0 12rpx 32rpx rgba(255, 176, 32, 0.08);
}

.section-title {
  display: block;
  font-size: var(--font-ui-34, 34rpx);
  font-weight: 900;
  color: #222222;
  margin-bottom: 10rpx;
}

.section-subtitle {
  display: block;
  font-size: var(--font-ui-26, 26rpx);
  line-height: 1.45;
  color: #8a8f99;
  margin-bottom: 24rpx;
}

.extra-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.extra-item {
  min-height: 136rpx;
  border-radius: 26rpx;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(255, 176, 32, 0.12);
  box-shadow: 0 10rpx 24rpx rgba(255, 176, 32, 0.06);
}

.extra-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.extra-line-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.extra-icon-quote {
  background: #fff7e8;
  color: #f5a623;
}

.extra-icon-topic {
  background: #eef4ff;
  color: #4f7cff;
}

.extra-icon-twister {
  background: #fff0ea;
  color: #ff6b57;
}

.quote-icon {
  display: flex;
  gap: 7rpx;
  align-items: flex-start;
  justify-content: center;
}

.quote-mark {
  width: 9rpx;
  height: 18rpx;
  border-left: 4rpx solid #f5a623;
  border-bottom: 4rpx solid #f5a623;
  border-radius: 2rpx 0 0 8rpx;
  transform: skew(-8deg);
}

.dice-icon {
  border: 3rpx solid #4f7cff;
  border-radius: 9rpx;
  box-sizing: border-box;
}

.dice-dot {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #4f7cff;
}

.dot-one {
  left: 8rpx;
  top: 8rpx;
}

.dot-two {
  left: 14rpx;
  top: 14rpx;
}

.dot-three {
  right: 8rpx;
  bottom: 8rpx;
}

.wave-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.wave-line {
  width: 4rpx;
  border-radius: 999rpx;
  background: #ff6b57;
}

.wave-one {
  height: 16rpx;
  opacity: 0.72;
}

.wave-two {
  height: 28rpx;
}

.wave-three {
  height: 20rpx;
  opacity: 0.82;
}

.extra-content {
  min-width: 0;
  flex: 1;
}

.extra-title {
  display: block;
  font-size: var(--font-ui-29, 29rpx);
  color: #222222;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.extra-desc {
  display: -webkit-box;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.5;
  color: #8a8f99;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.extra-arrow {
  margin-left: 18rpx;
  flex-shrink: 0;
  color: #c79a38;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 24rpx;
}

.record-heading {
  display: block;
  font-size: var(--font-ui-34, 34rpx);
  font-weight: 900;
  color: #111111;
}

.record-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8a8f99;
  font-size: var(--font-ui-24, 24rpx);
  line-height: 1.4;
}

.continue-btn {
  flex-shrink: 0;
  width: 168rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  background: #eaf8f0;
  color: #07c160;
  font-size: var(--font-ui-25, 25rpx);
  font-weight: 800;
}

.recent-body {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: #f8fafc;
}

.recent-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  font-size: var(--font-ui-30, 30rpx);
  color: #111111;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.record-desc,
.empty {
  display: block;
  font-size: var(--font-reading-26, 26rpx);
  color: #7f8794;
  line-height: 1.55;
}

.record-time {
  display: block;
  margin-top: 10rpx;
  color: #a0a7b5;
  font-size: 24rpx;
}

.record-status {
  flex-shrink: 0;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  color: #07c160;
  background: #eaf8f0;
  font-size: var(--font-ui-22, 22rpx);
  font-weight: 900;
}

.recent-empty {
  padding: 28rpx;
  border-radius: 26rpx;
  background: #f8fafc;
}

.empty-title {
  display: block;
  color: #111111;
  font-size: var(--font-reading-29, 29rpx);
  font-weight: 900;
  margin-bottom: 8rpx;
}

.weekly-schedule-group {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.weekly-strip {
  min-height: 106rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dcefe7;
  box-shadow: 0 10rpx 24rpx rgba(31, 80, 64, 0.05);
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.weekly-strip-adult {
  background: #f4fbf7;
}

.weekly-strip-college {
  border-color: #dfe7f8;
  background: #f5f8ff;
}

.weekly-strip-left {
  display: block;
  color: #17352d;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 800;
}

.weekly-strip-copy {
  flex: 1;
  min-width: 0;
}

.weekly-strip-text {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #4b5563;
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.45;
}

.weekly-strip-empty {
  color: #8a92a3;
}

.weekly-strip-action {
  flex-shrink: 0;
  color: #07c160;
  font-size: var(--font-ui-24, 24rpx);
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.weekly-strip-arrow {
  font-size: 34rpx;
  line-height: 1;
  font-weight: 500;
}
