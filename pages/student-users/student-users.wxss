page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card,
.user-card,
.empty-card {
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #edf1f6;
  box-shadow: 0 14rpx 36rpx rgba(31, 41, 55, 0.05);
}

.hero-card {
  padding: 34rpx;
}

.hero-title {
  display: block;
  color: #111827;
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 900;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  color: #8a93a3;
  font-size: 26rpx;
  line-height: 1.55;
}

.user-list {
  margin-top: 24rpx;
}

.user-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.user-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar-text {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #eaf8f0;
  color: #16c784;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.nickname {
  display: block;
  color: #111827;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 900;
}

.openid-text {
  display: block;
  margin-top: 6rpx;
  color: #8a93a3;
  font-size: 24rpx;
}

.member-tag {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.member-on {
  color: #8a5a16;
  background: #fff4dc;
}

.member-off {
  color: #8a93a3;
  background: #f2f4f7;
}

.info-grid {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #606875;
  font-size: 24rpx;
  line-height: 1.5;
}

.clear-btn {
  margin-top: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  color: #d84d4d;
  background: #fff0f0;
  font-size: 27rpx;
  font-weight: 900;
}

.empty-card {
  margin-top: 24rpx;
  padding: 48rpx 36rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #111827;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  display: block;
  margin-top: 16rpx;
  color: #8a93a3;
  font-size: 26rpx;
  line-height: 1.6;
}
