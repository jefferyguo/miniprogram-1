page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.module-hero {
  border-radius: 36rpx;
  padding: 40rpx 34rpx;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.10);
}

.module-reading {
  background: linear-gradient(135deg, #4FB99F 0%, #6BC7B2 100%);
}

.module-retell {
  background: linear-gradient(135deg, #6D7FD6 0%, #8A80E8 100%);
}

.module-topic {
  background: linear-gradient(135deg, #E98D7A 0%, #F2A28E 100%);
}

.module-mandarin {
  background: linear-gradient(135deg, #5C9FD6 0%, #78A7E3 100%);
}

.module-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  margin-bottom: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.14);
}

.line-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}

.book-page {
  position: absolute;
  top: 7rpx;
  width: 16rpx;
  height: 26rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
}

.book-left {
  left: 3rpx;
  border-radius: 6rpx 2rpx 2rpx 6rpx;
}

.book-right {
  right: 3rpx;
  border-radius: 2rpx 6rpx 6rpx 2rpx;
}

.book-spine {
  position: absolute;
  left: 19rpx;
  top: 8rpx;
  width: 2rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
}

.loop-arc {
  position: absolute;
  width: 28rpx;
  height: 17rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
}

.loop-top {
  top: 5rpx;
  left: 4rpx;
  border-bottom: none;
  border-radius: 18rpx 18rpx 0 0;
}

.loop-bottom {
  right: 4rpx;
  bottom: 5rpx;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
}

.loop-arrow {
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
}

.loop-arrow-top {
  top: 3rpx;
  right: 3rpx;
  border-width: 6rpx 0 6rpx 8rpx;
  border-color: transparent transparent transparent rgba(255, 255, 255, 0.92);
}

.loop-arrow-bottom {
  bottom: 3rpx;
  left: 3rpx;
  border-width: 6rpx 8rpx 6rpx 0;
  border-color: transparent rgba(255, 255, 255, 0.92) transparent transparent;
}

.bubble-box {
  position: absolute;
  left: 4rpx;
  top: 7rpx;
  width: 32rpx;
  height: 23rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 10rpx;
  box-sizing: border-box;
}

.bubble-tail {
  position: absolute;
  left: 13rpx;
  bottom: 5rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid rgba(255, 255, 255, 0.92);
  border-bottom: 3rpx solid rgba(255, 255, 255, 0.92);
  transform: rotate(-28deg);
  box-sizing: border-box;
}

.mic-head {
  position: absolute;
  left: 12rpx;
  top: 3rpx;
  width: 16rpx;
  height: 25rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.mic-stem {
  position: absolute;
  left: 19rpx;
  top: 28rpx;
  width: 3rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
}

.mic-base {
  position: absolute;
  left: 11rpx;
  bottom: 0;
  width: 18rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
}

.module-title {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  margin-bottom: 16rpx;
}

.module-desc {
  display: block;
  font-size: 28rpx;
  line-height: 1.55;
  opacity: 0.92;
  margin-bottom: 26rpx;
}

.module-progress {
  font-size: 25rpx;
  font-weight: 800;
}

.progress-panel {
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.18);
}

.progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.progress-text {
  font-size: 28rpx;
  font-weight: 900;
}

.progress-track {
  height: 22rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.28);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #ffffff;
}

.day-list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.day-card {
  border-radius: 30rpx;
  padding: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
  border-left: 8rpx solid transparent;
  box-sizing: border-box;
}

.completed-card {
  border-left-color: #07c160;
  background: #fbfffd;
  border-top: 1rpx solid #dff5e8;
  border-right: 1rpx solid #dff5e8;
  border-bottom: 1rpx solid #dff5e8;
}

.day-main {
  min-width: 0;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 10rpx;
}

.day-index {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 900;
}

.day-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.35;
  color: #111111;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.day-meta {
  display: block;
  font-size: 24rpx;
  color: #7f8794;
  line-height: 1.4;
}

.status-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.done-tag {
  background: #eaf8ef;
  color: #07c160;
}

.todo-tag {
  background: #f1f3f6;
  color: #8a8f99;
}
