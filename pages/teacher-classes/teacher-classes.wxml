<view class="page">
  <view class="hero-card">
    <text class="hero-title">班级管理</text>
    <text class="hero-desc">创建班级，复制班级码，查看班级作品</text>
  </view>

  <button class="create-btn" bindtap="createClass">创建班级</button>

  <view class="section">
    <text class="section-title">班级列表</text>

    <view wx:if="{{classes.length > 0}}">
      <view class="class-card" wx:for="{{classes}}" wx:key="id">
        <view class="class-top">
          <text class="class-name">{{item.className}}</text>
          <text class="status-tag">进行中</text>
        </view>

        <view class="class-info">
          <text>班级码：{{item.classCode}}</text>
          <text>老师：{{item.teacherName}}</text>
          <text>学员数：{{item.studentCount}} 人</text>
          <text>创建时间：{{item.createdAt}}</text>
        </view>

        <view class="class-actions">
          <button class="copy-btn" data-code="{{item.classCode}}" bindtap="copyClassCode">复制班级码</button>
          <button class="qr-btn" data-id="{{item.id}}" bindtap="showClassQr">班级二维码</button>
          <button class="works-btn" data-id="{{item.id}}" bindtap="viewWorks">查看作品</button>
        </view>
      </view>
    </view>

    <view class="empty-card" wx:else>
      <text class="empty-title">还没有班级</text>
      <text class="empty-desc">先创建一个班级，再把班级码发给学员加入。</text>
    </view>
  </view>

  <view class="teacher-tabbar">
    <view class="teacher-tab-item" data-url="/pages/teacher-home/teacher-home" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">台</text>
      <text>工作台</text>
    </view>
    <view class="teacher-tab-item active" data-url="/pages/teacher-classes/teacher-classes" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">班</text>
      <text>班级</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-review/teacher-review?type=all" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">作</text>
      <text>作品</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-favorites/teacher-favorites" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">藏</text>
      <text>收藏</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-home/teacher-home" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">师</text>
      <text>我的</text>
    </view>
  </view>

  <view class="qr-mask" wx:if="{{qrPopupVisible}}" catchtap="closeQrPopup">
    <view class="qr-popup" catchtap="noop">
      <text class="qr-popup-title">班级二维码</text>
      <text class="qr-popup-name">{{currentQrClass.className}}</text>
      <image
        wx:if="{{currentQrUrl && !qrLoadError}}"
        class="qr-image"
        src="{{currentQrUrl}}"
        mode="aspectFit"
        binderror="onQrImageError"
      />
      <view wx:else class="qr-placeholder">
        <text>二维码待生成</text>
      </view>
      <text class="qr-tip">让学员扫码加入班级</text>
      <button class="qr-close-btn" bindtap="closeQrPopup">关闭</button>
    </view>
  </view>
</view>
