page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 170rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card {
  border-radius: 34rpx;
  padding: 42rpx 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #27364a 0%, #3a4a63 100%);
  box-shadow: 0 16rpx 42rpx rgba(38, 50, 70, 0.16);
}

.hero-title {
  display: block;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc {
  display: block;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.5;
}

.create-btn {
  height: 86rpx;
  line-height: 86rpx;
  margin: 28rpx 0 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #07c160;
  font-size: 29rpx;
  font-weight: 900;
}

.section {
  margin-top: 34rpx;
}

.section-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.class-card,
.empty-card {
  border-radius: 30rpx;
  padding: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.class-card {
  margin-bottom: 22rpx;
}

.class-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.class-name {
  min-width: 0;
  color: #111111;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 900;
}

.status-tag {
  flex-shrink: 0;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  color: #07c160;
  background: #eaf8f0;
  font-size: 23rpx;
  font-weight: 900;
}

.class-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #737b88;
  font-size: 25rpx;
  line-height: 1.5;
}

.class-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.copy-btn,
.qr-btn,
.works-btn {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.copy-btn {
  color: #3478f6;
  background: #eef4ff;
}

.qr-btn {
  color: #253246;
  background: #f1f5fb;
}

.works-btn {
  color: #ffffff;
  background: #07c160;
}

.empty-card {
  text-align: center;
}

.empty-title {
  display: block;
  color: #111111;
  font-size: 31rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.empty-desc {
  display: block;
  color: #8a8f99;
  font-size: 25rpx;
  line-height: 1.55;
}

.teacher-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  background: #ffffff;
  border-top: 1rpx solid #eef0f4;
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 99;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -8rpx 28rpx rgba(38, 50, 70, 0.05);
}

.teacher-tab-item {
  flex: 1;
  text-align: center;
  color: #8a8f99;
  font-size: 22rpx;
  line-height: 1.25;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.teacher-tab-item.active {
  color: #1f6feb;
  font-weight: 700;
}

.teacher-tab-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 14rpx;
  background: #f2f5fa;
  font-size: 21rpx;
  font-weight: 900;
}

.teacher-tab-item.active .teacher-tab-icon {
  color: #ffffff;
  background: #1f6feb;
}

.qr-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  z-index: 200;
}

.qr-popup {
  width: 100%;
  max-width: 620rpx;
  border-radius: 34rpx;
  background: #ffffff;
  padding: 34rpx 30rpx 30rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.2);
  text-align: center;
}

.qr-popup-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
}

.qr-popup-name {
  display: block;
  margin-top: 10rpx;
  color: #8a8f99;
  font-size: 24rpx;
  line-height: 1.4;
}

.qr-image {
  width: 420rpx;
  height: 420rpx;
  display: block;
  margin: 24rpx auto 0;
  border-radius: 24rpx;
  background: #f7f8fb;
}

.qr-placeholder {
  width: 420rpx;
  height: 420rpx;
  margin: 24rpx auto 0;
  border-radius: 24rpx;
  background: #f5f7fb;
  color: #8a8f99;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-tip {
  display: block;
  margin-top: 20rpx;
  color: #8a8f99;
  font-size: 25rpx;
  line-height: 1.45;
}

.qr-close-btn {
  width: 100%;
  height: 78rpx;
  line-height: 78rpx;
  margin-top: 26rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #07c160;
  font-size: 28rpx;
  font-weight: 800;
}
