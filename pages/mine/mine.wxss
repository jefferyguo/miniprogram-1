page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.profile-card {
  margin: 0 4rpx;
  padding: 34rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #27364a 0%, #3a4a63 100%);
  box-sizing: border-box;
  box-shadow: 0 16rpx 40rpx rgba(39, 54, 74, 0.16);
}

.profile-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar-text {
  width: 96rpx;
  height: 96rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.nickname {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 12rpx;
}

.role-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.role-badge {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 600;
}

.profile-tip {
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
  line-height: 1.45;
}

.edit-profile-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #253246;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
}

.edit-profile-btn::after {
  border: none;
}

.quick-card {
  margin-top: 28rpx;
  border-radius: 32rpx;
  padding: 26rpx 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 10rpx;
}

.quick-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 10rpx 6rpx;
}

.quick-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  margin: 0 auto 16rpx;
  background: #eef3fa;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-icon {
  color: #2f3a4a;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 900;
}

.quick-title {
  display: block;
  color: #111111;
  font-size: 27rpx;
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.quick-desc {
  display: block;
  color: #8a8f99;
  font-size: 21rpx;
  line-height: 1.35;
}

.section {
  margin-top: 34rpx;
}

.section-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.class-card {
  border-radius: 32rpx;
  padding: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.class-name {
  display: block;
  color: #111111;
  font-size: 31rpx;
  line-height: 1.4;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.class-desc {
  display: block;
  color: #747c88;
  font-size: 25rpx;
  line-height: 1.55;
}

.class-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.join-class-btn,
.class-info-btn,
.class-exit-btn {
  height: 72rpx;
  line-height: 72rpx;
  margin: 24rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.class-info-btn,
.class-exit-btn {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.join-class-btn {
  width: 220rpx;
  color: #ffffff;
  background: #07c160;
}

.class-info-btn {
  color: #07c160;
  background: #eaf8f0;
}

.class-exit-btn {
  color: #d84d4d;
  background: #fff0f0;
}

.join-class-btn::after,
.class-info-btn::after,
.class-exit-btn::after {
  border: none;
}

.list-card {
  border-radius: 32rpx;
  padding: 8rpx 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.list-item {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f2f6;
}

.list-item:last-child {
  border-bottom: none;
}

.share-list-item {
  width: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  text-align: left;
}

.share-list-item::after {
  border: none;
}

.list-title {
  color: #111111;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 800;
}

.arrow {
  color: #a0a6b1;
  font-size: 48rpx;
  line-height: 1;
}

.footer {
  margin-top: 44rpx;
  text-align: center;
  color: #a0a6b1;
  font-size: 24rpx;
  line-height: 1.8;
  display: flex;
  flex-direction: column;
}
