<view class="page">
  <view class="hero-card">
    <text class="hero-title">作品点评</text>
    <text class="hero-desc">当前筛选：{{filterText}}</text>
    <text wx:if="{{className}}" class="hero-class">当前班级：{{className}}</text>
  </view>

  <view class="filter-tabs">
    <view
      class="filter-tab {{type === item.type ? 'active' : ''}}"
      wx:for="{{filterOptions}}"
      wx:key="type"
      data-type="{{item.type}}"
      bindtap="switchReviewFilter"
    >{{item.text}}</view>
  </view>

  <view class="section">
    <text class="section-title">作品列表</text>

    <view wx:if="{{works.length > 0}}">
      <view class="work-card" wx:for="{{works}}" wx:key="key">
        <view class="work-top">
          <text class="work-type">{{item.displayType}}</text>
          <text class="status-tag {{item.hasTeacherFeedback ? 'done-tag' : 'pending-tag'}}">{{item.teacherStatusText}}</text>
        </view>

        <text class="student-name">学员：{{item.studentName || '同学'}}</text>
        <text wx:if="{{item.className}}" class="work-meta-text">班级：{{item.className}}</text>
        <text class="work-title">{{item.displayTitle}}</text>
        <text class="work-desc">{{item.displaySubtitle}}</text>

        <view class="work-meta">
          <text>时长：{{item.displayDuration}}</text>
          <text>提交时间：{{item.displayCreatedAt}}</text>
          <text>AI反馈：{{item.aiStatusText}}</text>
        </view>

        <view class="work-actions">
          <button class="play-btn" data-key="{{item.key}}" bindtap="playWork">{{item.displayActionText}}</button>
          <button wx:if="{{!item.hasTeacherFeedback}}" class="write-btn" data-key="{{item.key}}" bindtap="writeFeedback">写点评</button>
          <button
            wx:if="{{item.hasTeacherFeedback}}"
            class="view-btn"
            data-key="{{item.key}}"
            bindtap="viewFeedback"
          >查看点评</button>
          <button class="favorite-btn {{item.isFavorited ? 'favorite-done-btn' : ''}}" data-key="{{item.key}}" bindtap="collectWork">{{item.favoriteText}}</button>
        </view>

        <view class="comment-form" wx:if="{{activeWorkKey === item.key}}">
          <textarea
            class="comment-input"
            value="{{commentText}}"
            maxlength="400"
            placeholder="请输入给学员的点评，例如声音状态、表达优点和下一步建议"
            bindinput="onCommentInput"
          />

          <text class="form-label">快捷标签</text>
          <view class="tag-row">
            <text
              class="quick-tag {{tag.selected ? 'quick-tag-active' : ''}}"
              wx:for="{{quickTags}}"
              wx:for-item="tag"
              wx:key="label"
              data-tag="{{tag.label}}"
              bindtap="toggleTag"
            >{{tag.label}}</text>
          </view>

          <text class="form-label">评分</text>
          <view class="score-row">
            <text
              class="score-item {{selectedScore === score ? 'score-active' : ''}}"
              wx:for="{{scores}}"
              wx:for-item="score"
              wx:key="*this"
              data-score="{{score}}"
              bindtap="selectScore"
            >{{score}}</text>
          </view>

          <view class="form-actions">
            <button class="cancel-btn" bindtap="cancelFeedback">取消</button>
            <button class="save-btn" data-key="{{item.key}}" bindtap="saveFeedback">保存点评</button>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-card" wx:else>
      <text class="empty-title">{{className ? '当前班级暂无提交作品' : '暂无提交作品'}}</text>
      <text class="empty-desc">学员提交训练作品后，会出现在这里。</text>
    </view>
  </view>

  <view class="teacher-tabbar">
    <view class="teacher-tab-item" data-url="/pages/teacher-home/teacher-home" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">台</text>
      <text>工作台</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-classes/teacher-classes" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">班</text>
      <text>班级</text>
    </view>
    <view class="teacher-tab-item active" data-url="/pages/teacher-review/teacher-review?type=all" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">作</text>
      <text>作品</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-favorites/teacher-favorites" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">藏</text>
      <text>收藏</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-home/teacher-home" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">师</text>
      <text>我的</text>
    </view>
  </view>
</view>
