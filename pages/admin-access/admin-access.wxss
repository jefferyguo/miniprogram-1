page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 30rpx 28rpx 64rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.hero-card {
  padding: 36rpx 34rpx;
  border-radius: 30rpx;
  background: #17352d;
  box-shadow: 0 18rpx 42rpx rgba(23, 53, 45, 0.16);
}

.hero-kicker,
.hero-title,
.hero-desc,
.status-label,
.status-title,
.status-desc,
.init-tip,
.menu-title,
.menu-desc,
.empty-title,
.empty-desc {
  display: block;
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: var(--font-ui-46, 46rpx);
  line-height: 1.2;
  font-weight: 800;
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--font-reading-25, 25rpx);
  line-height: 1.55;
}

.admin-status-card,
.init-card,
.empty-card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #e8edf2;
  border-radius: 26rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 10rpx 28rpx rgba(31, 41, 55, 0.04);
}

.admin-status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.admin-active-card {
  border-color: #d7ece3;
}

.admin-empty-card {
  border-color: #f0dfc9;
}

.status-label {
  color: #8a92a3;
  font-size: var(--font-ui-22, 22rpx);
}

.status-title {
  margin-top: 6rpx;
  color: #17202e;
  font-size: var(--font-ui-30, 30rpx);
  font-weight: 800;
}

.status-desc {
  margin-top: 6rpx;
  color: #7a8291;
  font-size: var(--font-reading-23, 23rpx);
}

.status-dot {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #c5cad1;
}

.status-dot-active {
  background: #07c160;
  box-shadow: 0 0 0 10rpx rgba(7, 193, 96, 0.1);
}

.init-tip {
  color: #6f7887;
  font-size: var(--font-reading-23, 23rpx);
  line-height: 1.5;
}

.init-btn {
  width: 100%;
  height: 70rpx;
  line-height: 70rpx;
  margin: 18rpx 0 0;
  padding: 0;
  border-radius: 35rpx;
  color: #ffffff;
  background: #07c160;
  font-size: var(--font-ui-25, 25rpx);
  font-weight: 700;
}

.menu-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.menu-card {
  min-width: 0;
  min-height: 300rpx;
  padding: 24rpx;
  border: 1rpx solid #e8edf2;
  border-radius: 26rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 12rpx 30rpx rgba(31, 41, 55, 0.05);
  display: flex;
  flex-direction: column;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 800;
}

.menu-green .menu-icon {
  color: #087b4d;
  background: #e7f7ef;
}

.menu-blue .menu-icon {
  color: #3478f6;
  background: #edf4ff;
}

.menu-violet .menu-icon {
  color: #6d5cd6;
  background: #f0edff;
}

.menu-amber .menu-icon {
  color: #9a6812;
  background: #fff4dc;
}

.menu-title {
  margin-top: 20rpx;
  color: #17202e;
  font-size: var(--font-ui-29, 29rpx);
  line-height: 1.35;
  font-weight: 800;
}

.menu-desc {
  margin-top: 10rpx;
  color: #7a8291;
  font-size: var(--font-reading-22, 22rpx);
  line-height: 1.48;
}

.menu-enter {
  margin-top: auto;
  padding-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #637083;
  font-size: 23rpx;
}

.menu-arrow {
  color: #9aa1ad;
  font-size: 40rpx;
  line-height: 1;
}

.empty-card {
  text-align: center;
}

.empty-title {
  color: #303948;
  font-size: var(--font-reading-29, 29rpx);
  font-weight: 800;
}

.empty-desc {
  margin-top: 10rpx;
  color: #7a8291;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.55;
}
