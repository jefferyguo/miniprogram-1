<view class="page">
  <view class="brand-card">
    <view class="logo-wrap">
      <image
        wx:if="{{!logoLoadError}}"
        class="logo"
        src="/images/yangqin-logo.jpg"
        mode="aspectFill"
        binderror="onLogoError"
      />
      <text wx:else class="logo-text">杨</text>
    </view>
    <text class="brand-title">杨勤口才训练KEEP</text>
    <text class="brand-desc">每天 3 分钟，练成好口才</text>
  </view>

  <view class="content-card">
    <text class="section-title">品牌介绍</text>
    <text class="paragraph">杨勤口才训练KEEP 是一个面向成年人、大学生和职场人群的表达训练工具。通过朗读、复述、话题表达、普通话训练和每日加餐训练，帮助用户建立开口习惯，提升声音状态、逻辑表达和表达自信。</text>
  </view>

  <view class="content-card">
    <text class="section-title">我们的训练理念</text>
    <view class="principle-item" wx:for="{{principles}}" wx:key="*this">
      <text class="dot"></text>
      <text class="principle-text">{{item}}</text>
    </view>
  </view>

  <view class="version-card">杨勤口才训练KEEP v1.0.2</view>
</view>
