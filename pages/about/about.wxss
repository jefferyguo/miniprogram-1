page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.brand-card,
.content-card,
.version-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.brand-card {
  padding: 42rpx 34rpx;
  text-align: center;
}

.logo-wrap {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 24rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background: #eaf8f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo {
  width: 100%;
  height: 100%;
}

.logo-text {
  color: #07c160;
  font-size: 52rpx;
  font-weight: 900;
}

.brand-title {
  display: block;
  color: #111111;
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.brand-desc {
  display: block;
  color: #07c160;
  font-size: 27rpx;
  font-weight: 800;
}

.content-card {
  margin-top: 26rpx;
  padding: 32rpx;
}

.section-title {
  display: block;
  color: #111111;
  font-size: 33rpx;
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.paragraph {
  display: block;
  color: #606875;
  font-size: 27rpx;
  line-height: 1.75;
}

.principle-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.principle-item:last-child {
  margin-bottom: 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #07c160;
  margin-top: 16rpx;
  flex-shrink: 0;
}

.principle-text {
  flex: 1;
  color: #606875;
  font-size: 27rpx;
  line-height: 1.65;
}

.version-card {
  margin-top: 26rpx;
  padding: 28rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 25rpx;
}
