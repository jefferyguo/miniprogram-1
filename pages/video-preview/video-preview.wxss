page {
  background: #101820;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 52rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.preview-card {
  min-height: calc(100vh - 84rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.video-shell {
  position: relative;
  width: 100%;
  height: 960rpx;
  max-height: 70vh;
  border-radius: 32rpx;
  overflow: hidden;
  background: #000000;
  box-shadow: 0 22rpx 60rpx rgba(0, 0, 0, 0.32);
}

.preview-video {
  width: 100%;
  height: 100%;
  transition: transform 0.2s ease;
}

.loading-layer,
.error-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.76);
  font-size: 27rpx;
  background: rgba(0, 0, 0, 0.22);
}

.video-info {
  margin-top: 28rpx;
  padding: 0 4rpx;
}

.video-title {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 900;
}

.video-time {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 25rpx;
}

.video-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 18rpx;
}

.action-btn {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #16c784;
  font-size: 27rpx;
  font-weight: 900;
}

.secondary-btn {
  color: #d7f7e6;
  background: rgba(255, 255, 255, 0.16);
}
