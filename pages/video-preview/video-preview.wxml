<page-meta page-style="{{fontSizePageStyle}}"></page-meta>
<view class="page">
  <view class="preview-card">
    <view class="video-shell">
      <video
        wx:if="{{src && !hasError}}"
        class="preview-video"
        style="transform: rotate({{rotate}}deg);"
        src="{{src}}"
        controls
        autoplay
        object-fit="{{objectFit}}"
        bindloadedmetadata="onVideoLoaded"
        bindtimeupdate="onTimeUpdate"
        binderror="onVideoError"
      ></video>

      <view wx:if="{{!isReady && !hasError}}" class="loading-layer">
        <text>视频加载中...</text>
      </view>

      <view wx:if="{{hasError}}" class="error-layer">
        <text>视频文件暂时无法查看</text>
      </view>
    </view>

    <view class="video-info">
      <text class="video-title">{{title}}</text>
      <text class="video-time">{{currentText}} / {{durationText}}</text>
    </view>

    <view class="video-actions">
      <button class="action-btn" bindtap="rotateVideo">旋转画面</button>
      <button class="action-btn secondary-btn" bindtap="toggleFit">{{fitText}}</button>
    </view>
  </view>
</view>
