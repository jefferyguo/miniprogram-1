<view class="page">
  <view class="hero-card">
    <text class="hero-title">收藏夹</text>
    <text class="hero-desc">收藏重点作品，按用途分类管理</text>
  </view>

  <view wx:if="{{mode === 'list'}}">
    <button class="create-btn" bindtap="createFolder">创建收藏夹</button>

    <view class="section">
      <text class="section-title">收藏夹列表</text>

      <view class="folder-card" wx:for="{{folders}}" wx:key="id">
        <view class="folder-top">
          <text class="folder-name">{{item.name}}</text>
          <text class="count-tag">{{item.workCount}} 个作品</text>
        </view>
        <text class="folder-desc">{{item.desc}}</text>
        <text class="folder-desc">创建时间：{{item.createdAt}}</text>

        <view class="folder-actions">
          <button class="view-btn" data-id="{{item.id}}" bindtap="openFolder">查看作品</button>
          <button class="rename-btn" data-id="{{item.id}}" bindtap="renameFolder">重命名</button>
          <button class="delete-btn {{item.isDefault ? 'disabled-btn' : ''}}" data-id="{{item.id}}" bindtap="deleteFolder">删除</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:else>
    <view class="detail-head">
      <button class="back-btn" bindtap="backToList">返回列表</button>
      <text class="detail-title">{{currentFolder.name}}</text>
    </view>

    <view wx:if="{{currentWorks.length > 0}}">
      <view class="work-card" wx:for="{{currentWorks}}" wx:key="id">
        <view class="work-top">
          <text class="work-type">{{item.displayType}}</text>
          <text class="status-tag">{{item.teacherStatusText}}</text>
        </view>
        <text class="student-name">学员：{{item.studentName || '同学'}}</text>
        <text wx:if="{{item.className}}" class="work-desc">班级：{{item.className}}</text>
        <text class="work-title">{{item.displayTitle}}</text>
        <text class="work-desc">{{item.taskTitle}}</text>
        <view class="work-meta">
          <text>时长：{{item.duration}}</text>
          <text>提交时间：{{item.submittedAt || '暂无'}}</text>
          <text>AI反馈：{{item.aiStatusText}}</text>
        </view>
        <view class="work-actions">
          <button class="play-btn" data-id="{{item.id}}" bindtap="playWork">{{item.displayActionText}}</button>
          <button class="feedback-btn" data-id="{{item.id}}" bindtap="viewFeedback">查看老师点评</button>
          <button class="remove-btn" data-id="{{item.id}}" bindtap="removeFavorite">移出收藏</button>
        </view>
      </view>
    </view>

    <view class="empty-card" wx:else>
      <text class="empty-title">这个收藏夹还没有作品</text>
      <text class="empty-desc">可以在老师点评列表中点击“收藏”加入作品。</text>
    </view>
  </view>

  <view class="teacher-tabbar">
    <view class="teacher-tab-item" data-url="/pages/teacher-home/teacher-home" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">台</text>
      <text>工作台</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-classes/teacher-classes" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">班</text>
      <text>班级</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-review/teacher-review?type=all" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">作</text>
      <text>作品</text>
    </view>
    <view class="teacher-tab-item active" data-url="/pages/teacher-favorites/teacher-favorites" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">藏</text>
      <text>收藏</text>
    </view>
    <view class="teacher-tab-item" data-url="/pages/teacher-home/teacher-home" bindtap="switchTeacherTab">
      <text class="teacher-tab-icon">师</text>
      <text>我的</text>
    </view>
  </view>
</view>
