page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.hero-card {
  border-radius: 36rpx;
  padding: 44rpx 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #17352d, #1f4b3f);
  box-shadow: 0 16rpx 42rpx rgba(23, 53, 45, 0.16);
}

.hero-title {
  display: block;
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.hero-desc,
.paragraph,
.qr-tip {
  display: block;
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-desc {
  opacity: 0.9;
}

.content-card,
.qr-card {
  margin-top: 26rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.qr-card {
  text-align: center;
  padding-top: 38rpx;
  padding-bottom: 38rpx;
}

.qr-title {
  display: block;
  color: #111111;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 26rpx;
}

.qr-image,
.qr-placeholder {
  width: 420rpx;
  height: 420rpx;
  display: block;
  margin: 0 auto;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.06);
}

.qr-placeholder {
  line-height: 420rpx;
  color: #8a8f99;
  background: #f5f7fb;
  font-size: 27rpx;
  box-shadow: none;
}

.qr-tip {
  margin-top: 24rpx;
  color: #8a8f99;
  text-align: center;
}

.section-title {
  display: block;
  color: #111111;
  font-size: 33rpx;
  line-height: 1.35;
  font-weight: 900;
  margin-bottom: 16rpx;
}

.paragraph {
  color: #606875;
}

.paragraph + .paragraph {
  margin-top: 12rpx;
}
