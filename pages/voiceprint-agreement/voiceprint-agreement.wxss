page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 64rpx;
  box-sizing: border-box;
}

.agreement-hero {
  padding: 40rpx 34rpx;
  border-radius: 28rpx;
  background: #27364a;
}

.agreement-title,
.agreement-desc,
.section-title,
.section-paragraph,
.agreement-footer text {
  display: block;
}

.agreement-title {
  color: #ffffff;
  font-size: var(--font-reading-42, 42rpx);
  line-height: 1.3;
  font-weight: 800;
}

.agreement-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.65;
}

.agreement-section {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 1rpx solid #e8ecf2;
  border-radius: 20rpx;
  background: #ffffff;
}

.section-title {
  color: #1f2937;
  font-size: var(--font-ui-31, 31rpx);
  line-height: 1.4;
  font-weight: 800;
}

.section-paragraph {
  margin-top: 16rpx;
  color: #606a78;
  font-size: var(--font-reading-27, 27rpx);
  line-height: 1.75;
}

.agreement-footer {
  margin-top: 28rpx;
  color: #98a1af;
  font-size: var(--font-reading-24, 24rpx);
  line-height: 1.7;
  text-align: center;
}
