<page-meta page-style="{{fontSizePageStyle}}"></page-meta>
<view class="page">
  <view class="agreement-hero">
    <text class="agreement-title">声纹授权协议</text>
    <text class="agreement-desc">本协议独立于隐私政策，仅在你使用录音或带声音录像功能前单独征得同意。</text>
  </view>

  <view class="agreement-section" wx:for="{{sections}}" wx:key="title">
    <text class="section-title">{{item.title}}</text>
    <text class="section-paragraph" wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this">{{paragraph}}</text>
  </view>

  <view class="agreement-footer">
    <text>协议版本：{{version}}</text>
    <text>生效日期：2026年8月10日</text>
  </view>
</view>
