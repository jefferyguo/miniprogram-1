page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 36rpx;
}

.title {
  display: block;
  font-size: var(--font-ui-52, 52rpx);
  font-weight: 800;
  color: #111111;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: var(--font-ui-28, 28rpx);
  color: #666666;
  line-height: 1.6;
}

.task-card {
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(135deg, #07c160, #20d98b);
  box-shadow: 0 16rpx 40rpx rgba(7, 193, 96, 0.18);
}

.task-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.task-label,
.task-progress {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.task-title {
  display: block;
  font-size: var(--font-ui-30, 30rpx);
  font-weight: 600;
  opacity: 0.9;
  margin-bottom: 14rpx;
}

.task-name {
  display: block;
  font-size: var(--font-ui-42, 42rpx);
  font-weight: 800;
  margin-bottom: 16rpx;
}

.task-desc {
  display: block;
  font-size: var(--font-reading-28, 28rpx);
  line-height: 1.6;
  opacity: 0.92;
  margin-bottom: 34rpx;
}

.record-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #07c160;
  font-size: var(--font-ui-30, 30rpx);
  font-weight: 700;
}

.section-title {
  margin: 40rpx 0 24rpx;
  font-size: var(--font-ui-34, 34rpx);
  font-weight: 800;
  color: #111111;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feature-card {
  min-height: 168rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.green-card {
  color: #ffffff;
  background: linear-gradient(135deg, #07c160, #20d98b);
}

.blue-card {
  color: #ffffff;
  background: linear-gradient(135deg, #3478f6, #6c5ce7);
}

.white-card {
  background: #ffffff;
}

.feature-title {
  display: block;
  font-size: var(--font-ui-34, 34rpx);
  font-weight: 800;
  margin-bottom: 12rpx;
}

.feature-desc {
  display: block;
  max-width: 520rpx;
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.5;
  opacity: 0.9;
}

.feature-arrow {
  font-size: 58rpx;
  font-weight: 300;
  opacity: 0.85;
  margin-left: 24rpx;
}

.dark-title {
  color: #111111;
}

.dark-desc,
.dark-arrow {
  color: #666666;
}

.buy-card {
  margin-top: 32rpx;
  border-radius: 32rpx;
  padding: 34rpx 32rpx;
  box-sizing: border-box;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.buy-title {
  display: block;
  font-size: var(--font-ui-34, 34rpx);
  font-weight: 800;
  margin-bottom: 12rpx;
}

.buy-desc {
  display: block;
  max-width: 440rpx;
  font-size: var(--font-reading-26, 26rpx);
  line-height: 1.5;
  opacity: 0.82;
}

.buy-action {
  flex-shrink: 0;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #111111;
  font-size: var(--font-ui-26, 26rpx);
  font-weight: 700;
}
